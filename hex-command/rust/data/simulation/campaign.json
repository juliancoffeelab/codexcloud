{
  "defaultMaxRounds": 100,
  "diplomacy": ["unrestricted", "diplomatic"],
  "policies": ["classic", "rush", "balanced", "rotated", "situational"],
  "defaultCampaigns": ["lantern-road", "eval-merfolk", "eval-skeletons", "eval-woodland"],
  "campaigns": {
    "lantern-road": {
      "diplomacy": ["unrestricted"],
      "routes": {
        "flight": {
          "stages": {
            "lantern-villages": {
              "ignoreOptionalWhen": {
                "kind": "flag",
                "flag": "village-safe"
              }
            }
          }
        },
        "fight": {
          "stages": {
            "lantern-villages": {
              "scriptEvents": [
                {
                  "id": "simulation-road-cleared",
                  "when": {
                    "flag": "road-cleared"
                  },
                  "objective": {
                    "faction": "player",
                    "label": "Defeat all enemies before leaving",
                    "optional": false,
                    "visibleWhen": {
                      "flag": "village-safe"
                    },
                    "intent": {
                      "defeat": {
                        "side": "enemy"
                      }
                    },
                    "playerMarker": null
                  },
                  "actions": [
                    {
                      "setFlag": "simulation-road-cleared"
                    }
                  ]
                }
              ],
              "scriptConditions": {
                "eastern-departure": {
                  "all": [
                    {
                      "all": [
                        {
                          "stand": {
                            "tile": {
                              "location": "exit"
                            },
                            "side": "player",
                            "character": "nera",
                            "through": true
                          }
                        },
                        {
                          "flag": "village-safe"
                        }
                      ]
                    },
                    {
                      "flag": "simulation-road-cleared"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "eval-merfolk": {
      "diplomacy": ["unrestricted"],
      "routes": {}
    },
    "eval-skeletons": {
      "diplomacy": ["unrestricted"],
      "routes": {
        "destroy": {
          "stages": {
            "eval-skeletons-cistern": {
              "scriptConditions": {
                "restore-intake": {
                  "always": false
                }
              },
              "scriptEvents": [
                {
                  "id": "simulation-destroy-route",
                  "when": {
                    "chapterStarted": true
                  },
                  "actions": [
                    {
                      "failObjective": "restore-intake"
                    }
                  ],
                  "priority": 90
                }
              ]
            }
          }
        },
        "restore": {
          "stages": {
            "eval-skeletons-cistern": {
              "scriptConditions": {
                "destroy-invasion": {
                  "always": false
                }
              },
              "scriptEvents": [
                {
                  "id": "simulation-restore-route",
                  "when": {
                    "chapterStarted": true
                  },
                  "actions": [
                    {
                      "failObjective": "destroy-invasion"
                    }
                  ],
                  "priority": 90
                }
              ]
            }
          }
        }
      }
    },
