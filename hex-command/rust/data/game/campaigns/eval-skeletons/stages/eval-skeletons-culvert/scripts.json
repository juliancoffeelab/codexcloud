    {
      "id": "culvert-parley",
      "when": {
        "noUnits": {
          "faction": "enemy"
        }
      },
      "actions": [
        {
          "say": [
            {
              "character": "bryn",
              "portrait": "fox-spearguard",
              "text": "Enough. I tended these waterworks before your master took the crypt. There is a dry service channel under the ridge."
            },
            {
              "character": "mira",
              "text": "Then show me."
            },
            {
              "character": "bryn",
              "portrait": "fox-spearguard",
              "text": "Your word first: no trees cut inside the grove. Vael’s roots have crossed the old boundary, but I will not trade our trees for your road."
            },
            {
              "character": "mira",
              "text": "I need the cistern. Keep your trees. Walk with us, and see that I keep my word."
            },
            {
              "character": "bryn",
              "portrait": "fox-spearguard",
              "text": "The old arch to the south is the mouth. Clear the latch and the stone door will open. I will bring others who accept these terms."
            }
          ]
        },
        {
          "spawn": {
            "faction": "player",
            "tile": {
              "hex": {
                "col": 5,
                "row": 7
              }
            },
            "radius": 2,
            "units": [
              {
                "type": "fox-spearguard",
                "character": "bryn"
              }
            ]
          }
        },
        {
          "unlockRecruits": {
            "faction": "player",
            "units": [
              {
                "unit": "fox-spearguard",
                "cost": 18
              }
            ]
          }
        },
        {
          "setFlag": "culvert-parley"
        }
      ],
      "objective": {
        "faction": "player",
        "label": "Defeat the Circle’s road screen",
        "intent": {
          "defeat": {
            "faction": "enemy"
          }
        },
        "visibleWhen": {
          "always": true
        }
      }
    },
    {
      "id": "culvert-open",
      "when": {
        "all": [
          {
            "flag": "culvert-parley"
          },
          {
            "stand": {
