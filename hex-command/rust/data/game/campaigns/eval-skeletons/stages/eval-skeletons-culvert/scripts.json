            },
            "terrain": "ruins"
          }
        },
        {
          "setFlag": "culvert-opened"
        },
        {
          "victory": "The dry culvert opens a route to the estate cistern."
        }
      ],
      "objective": {
        "faction": "player",
        "label": "Open the stone door at the dry culvert mouth",
        "intent": {
          "goTo": {
            "tile": {
