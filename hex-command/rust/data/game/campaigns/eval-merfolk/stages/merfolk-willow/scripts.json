{
  "requiredCompanions": ["mares"],
  "enemyGroups": [
    {
      "id": "forward",
      "order": {
        "kind": "hold",
        "area": [
          {
            "location": "focus"
          }
        ],
        "attackRadius": 2
      }
    },
    {
      "id": "mother",
      "when": {
        "condition": {
          "kind": "flag",
          "flag": "focus-broken"
        },
        "remember": true
      }
    },
    {
      "id": "raiders"
    },
    {
      "id": "cell",
      "order": {
        "kind": "hold",
        "area": [
          {
            "location": "cell"
          }
        ],
        "attackRadius": 1
      }
    }
  ],
  "events": [
    {
      "id": "willow-demand",
      "when": {
        "chapterStarted": true
      },
      "actions": [
        {
          "say": [
            {
              "character": "mother",
              "portrait": "wildkeeper",
              "text": "You brought both crews. Twice as many axes will not make this your bank."
            },
            {
              "character": "orra",
              "portrait": "tidekeeper",
              "text": "We came for the spring. Your guards have taken the worksite and driven us from the water."
            },
            {
              "character": "mother",
              "portrait": "wildkeeper",
              "text": "Your builders cut living roots. I will cover every plank they lay."
            },
            {
              "character": "mares",
              "portrait": "tidekeeper",
              "text": "Those thornshields guard the knot in the stonework. We cannot reach it through them."
            },
            {
              "character": "orra",
              "portrait": "tidekeeper",
              "text": "Then break their line and tear the knot out. She will not send another root across this bank."
            }
          ]
        },
        {
          "setFlag": "final-orders"
        }
      ],
      "priority": 30
    },
    {
      "id": "forward-cleared",
      "when": {
        "noUnits": {
          "aiGroup": "forward",
          "side": "enemy"
        }
      },
      "actions": [
        {
          "setFlag": "forward-cleared"
        },
        {
          "say": [
            {
              "character": "orra",
              "portrait": "tidekeeper",
              "text": "The springhead is clear. Get close to the stonework and pull that root-knot free. The roots must stop before we leave."
            }
          ]
        }
      ],
      "objective": {
        "faction": "player",
        "label": "Defeat the three forward guards at the springhead",
        "optional": false,
        "visibleWhen": {
          "flag": "final-orders"
        },
        "intent": {
          "defeat": {
            "side": "enemy",
            "aiGroup": "forward"
          }
        },
        "playerMarker": null
      }
    },
    {
      "id": "break-focus",
      "when": {
        "all": [
          {
            "flag": "forward-cleared"
          },
          {
            "proximity": {
              "tile": {
                "location": "focus"
              },
              "radius": 1,
              "side": "player"
            }
          }
        ]
      },
      "actions": [
        {
          "setFlag": "focus-broken"
        },
        {
          "setTerrain": {
            "tile": {
              "location": "focus"
            },
            "terrain": "ritual-spent"
          }
        },
        {
          "say": [
            {
              "character": "orra",
              "portrait": "tidekeeper",
              "text": "The knot is out. The roots have stopped moving."
            },
            {
              "with": "mother",
              "dialogue": [
                {
                  "character": "mares",
                  "portrait": "tidekeeper",
                  "text": "Then she has only her remaining guards. Finish this, captain."
                }
              ],
              "alternative": [
                {
                  "character": "mares",
                  "portrait": "tidekeeper",
                  "text": "No more roots to do her killing. The spring is ours."
                }
              ]
            }
          ]
        }
      ],
      "objective": {
        "faction": "player",
        "label": "Destroy the exposed root focus: approach within one hex",
        "optional": false,
        "visibleWhen": {
          "flag": "forward-cleared"
        },
        "intent": {
          "approach": {
            "tile": {
              "location": "focus"
            },
            "radius": 1,
            "side": "player"
          }
        },
        "playerMarker": {
          "tiles": [
            {
              "location": "focus"
            }
          ]
        }
      }
    },
    {
      "id": "mother-falls",
      "when": {
        "killed": {
          "character": "mother"
        }
      },
      "actions": [
        {
          "setFlag": "mother-defeated"
        }
      ]
    },
    {
      "id": "spring-won",
      "when": {
        "all": [
          {
            "flag": "forward-cleared"
          },
          {
            "flag": "focus-broken"
          },
          {
            "flag": "mother-defeated"
          }
        ]
      },
      "actions": [
        {
          "setFlag": "orra-captain"
        },
        {
          "victory": "The root focus is destroyed and the Root-Crown Mother falls. The spring is free of her occupation."
        }
      ],
      "objective": {
        "faction": "player",
        "label": "Defeat the Root-Crown Mother",
        "optional": false,
        "visibleWhen": {
          "flag": "focus-broken"
        },
        "intent": {
          "defeat": {
            "side": "enemy",
            "character": "mother"
          }
        },
        "playerMarker": null
      }
    },
