              "location": "mother-keep"
            },
            "radius": 4,
            "aiGroup": "raiders",
            "units": ["wolf", "wolf", "thorncaller"]
          }
        },
        {
          "log": "A fresh thorn patrol comes out of the willow bank."
        }
      ]
    },
    {
      "id": "cell-discovered",
      "when": {
        "proximity": {
          "tile": {
            "location": "cell"
          },
          "radius": 3,
          "side": "player"
        }
      },
      "actions": [
        {
          "say": [
            {
              "speaker": "Trapped scout",
              "portrait": "reefguard",
              "text": "Here! Under the roots! Her guard took my spear. Get him away from this cage!"
            },
            {
              "character": "orra",
              "portrait": "tidekeeper",
              "text": "We can reach you from the water. Keep back while we cut you loose."
            }
          ]
        },
        {
          "setFlag": "cell-known"
        }
      ]
    },
    {
      "id": "cell-guard-falls",
      "when": {
        "killed": {
          "character": "cell-guard"
        }
      },
      "actions": [
        {
          "setFlag": "cell-guard-dead"
        }
      ]
    },
    {
      "id": "release-scout",
      "when": {
        "all": [
          {
            "flag": "cell-known"
          },
          {
            "flag": "cell-guard-dead"
          },
          {
            "proximity": {
              "tile": {
                "location": "cell"
              },
              "radius": 1,
              "side": "player"
            }
          }
        ]
      },
      "actions": [
        {
          "spawn": {
            "faction": "player",
            "tile": {
              "location": "cell"
            },
            "radius": 2,
            "units": [
              {
                "type": "reefguard",
                "character": "freed-scout"
              }
            ]
          }
        },
        {
          "say": [
            {
              "speaker": "Freed scout",
              "portrait": "reefguard",
              "text": "A spear. Good. I can still use one. Let me help you finish this."
            }
          ]
        },
        {
          "setFlag": "scout-released"
        }
      ],
      "objective": {
        "faction": "player",
        "label": "Release the scout: defeat his guard and approach the cell",
        "optional": true,
        "visibleWhen": {
          "flag": "cell-known"
        },
        "intent": {
          "approach": {
            "tile": {
              "location": "cell"
            },
            "radius": 1,
            "side": "player"
          }
        },
        "playerMarker": {
          "tiles": [
            {
              "location": "cell"
            }
          ]
        }
      }
    },
