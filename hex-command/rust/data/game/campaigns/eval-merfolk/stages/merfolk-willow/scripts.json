        },
        {
          "setTerrain": {
            "tile": {
              "location": "root-h"
            },
            "terrain": "forest"
          }
        },
        {
          "log": "Living roots spread across the marked bank."
        }
      ]
    },
    {
      "id": "willow-second-pulse",
