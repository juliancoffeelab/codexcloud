        {
          "setTerrain": {
            "tile": {
              "location": "root-j"
            },
            "terrain": "forest"
          }
        },
        {
          "log": "Living roots spread across the marked bank."
        }
      ]
    },
    {
      "id": "willow-reserve",
      "when": {
        "all": [
          {
            "turnAtLeast": 6
          },
          {
            "not": {
              "flag": "focus-broken"
            }
          }
        ]
