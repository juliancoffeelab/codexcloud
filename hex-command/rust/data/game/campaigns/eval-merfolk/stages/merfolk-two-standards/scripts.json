{
  "requiredCompanions": ["mares"],
  "events": [
    {
      "id": "joint-command",
      "when": {
        "chapterStarted": true
      },
      "actions": [
        {
          "say": [
            {
              "character": "mares",
              "portrait": "tidekeeper",
              "text": "Orra! The roots have covered the route on your map. My rear guard is still coming through the inlet. We cannot leave them here."
            },
            {
              "character": "orra",
              "portrait": "tidekeeper",
              "text": "Then we hold together. Put your guards under my orders until they are through."
            },
            {
              "character": "mares",
              "portrait": "tidekeeper",
              "text": "For this fight. Bring the company back to the spring, and I will hear your claim to the captaincy."
            },
            {
              "character": "orra",
              "portrait": "tidekeeper",
              "text": "Keep yourself alive, Mares. We hold this inlet until your rear guard is through. They can wait in the outer channel if the bank is lost, but they cannot join us until we retake it. Our forward reserve is waiting for a standard on either bank."
            }
          ]
        },
        {
          "changeAllegiance": {
            "units": {
              "faction": "rival"
            },
            "faction": "player"
          }
        },
        {
          "setTerrain": {
            "tile": {
              "location": "old-route"
            },
            "terrain": "forest"
          }
        },
        {
          "setFlag": "joint-command"
        }
      ],
      "priority": 30
    },
    {
