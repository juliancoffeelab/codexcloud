  "subtitle": "The books can wait. The workers cannot.",
  "briefing": "Reach the wreck and recover the ledger. The rescue boat arrives at high tide on turn 6. Once the boat is here and the wreck is yours, defend it through three enemy turns to get the workers out.",
  "debrief": "The last worker leaves with the ledger. Senn had paid Vale to seize the posts, then charged the villagers for salvage they never requested. Tomas deserted when ordered to burn the hull with workers inside. He knows the wooded route to the upper gate.",
  "requiredCompanions": ["Edda"],
  "companionLosses": {
    "Tomas": {
      "debrief": "The workers leave with the ledger, but Tomas dies defending their escape. The rescued clerk explains that Senn's upper gate must open with the lower one to avoid flooding the village. His fellow deserters offer to guide the company along the wooded bank.",
      "victory": [
        {
          "speaker": "Edda",
          "portrait": "harpooner",
          "text": "Last boat away. The clerk has the books. Tomas did not make it back."
        },
        {
          "speaker": "Mira",
          "portrait": "tidekeeper",
          "text": "We carry his testimony too. The clerk says we need both gates and the beacon; nobody else will die in a release we could have prevented."
        }
      ]
    }
  },
  "hints": [
    "Reach the wreck on the central sandbar. Rescue starts at high tide on turn 6; then defend it for three enemy turns.",
    "Land allies use the northern sandbar and wooded shore; merfolk flank through sea and marshes.",
    "Enemy recapture resets the rescue counter. You can leave the wreck, but keep it under your control."
  ],
  "goals": [
    {
      "kind": "event",
      "label": "Recover the original ledger from the wreck",
      "tile": "5,4",
      "event": "ledger"
    },
    {
      "kind": "hold",
      "label": "Defend the wreck through 3 enemy turns during the rescue",
      "tile": "5,4",
      "turns": 3,
      "earliestRound": 6,
      "startEvent": "rescue"
    }
  ],
  "recruits": ["reefguard", "harpooner", "wavemender", "spearman", "adept"],
  "enemyRecruits": ["swordsman", "spearman", "archer"],
  "gold": 14,
  "enemyGold": 10,
  "intro": [
    {
      "speaker": "Tomas",
      "portrait": "spearman",
      "text": "I was hired to guard a salvage crew. Today Senn ordered us to set the ship alight. There are still people down there."
    },
    {
      "speaker": "Edda",
      "portrait": "harpooner",
      "text": "The rescue boat can enter this channel at high tide. First, get us to the wreck. Nobody touches the quarry gate while people are still inside."
    },
    {
      "speaker": "Foreman Cale",
      "portrait": "commander",
      "text": "The factor's ledger is company property. Clear the landing and burn the books."
    },
    {
      "speaker": "Mira",
      "portrait": "tidekeeper",
      "text": "A debt cannot give you ownership of a person. We take the wreck and get everyone out."
    }
  ],
  "legacyDialogue": [
    {
      "speaker": "Factor Senn",
      "portrait": "commander",
      "text": "That ledger is company property. Vale, clear the landing."
    },
    {
      "speaker": "Edda",
      "portrait": "harpooner",
      "text": "I can bring them out along the keel. Hold this landing until the sixth bell; nobody touches the quarry gate before then."
    },
    {
      "speaker": "Edda",
      "portrait": "harpooner",
      "text": "I need three ferry crossings to bring everyone out along the keel. Hold the landing. The last boat leaves with the sixth bell's high tide, or later if we are delayed; nobody touches the quarry gate before then."
    },
    {
      "speaker": "Mira",
      "portrait": "tidekeeper",
      "text": "A debt cannot give you ownership of a person. We take the books after we get everyone out."
    }
  ],
  "victory": [
    {
      "speaker": "Edda",
      "portrait": "harpooner",
      "text": "Last boat away. The clerk brought the books with her. Every order, every payment."
    },
    {
      "speaker": "Tomas",
      "portrait": "spearman",
