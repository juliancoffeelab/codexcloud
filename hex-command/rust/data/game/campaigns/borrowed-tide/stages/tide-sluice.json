  "subtitle": "One gate for the town, one for the sea.",
  "briefing": "Capture the two sluice controls and escort Edda to the beacon. She will signal a safe release only after both gates are in your hands. Senn's guards defend the gates to prevent the council from discovering the diversion.",
  "debrief": "At Edda's signal both controls release together. The estuary fills without a surge through the village. The recovered books reach the council; Senn loses his lease. The fishing towns and the reef appoint a shared tide crew, with neither shore allowed to operate a gate alone.",
  "hints": [
    "Capture both forts: the upper sluice beside the wooded bank and the lower sluice beside the marsh. Bring Edda to the ruined beacon east of the lower channel; all three objectives are required.",
    "Land allies can cross the northern sandbar to the wooded high bank. Swimmers can flank through deep water and the lower marsh channel. Guard the shallows back to Mira's keep.",
    "Impact attacks break the armored gate guards; harpoons punish scouts and cover advancing allies. Wavemenders heal adjacent allies at turn start."
  ],
  "goals": [
    {
      "kind": "control",
      "label": "Control both sluice gates",
      "tiles": ["8,2", "8,5"]
    },
    {
      "kind": "escort",
      "label": "Bring Edda to the release beacon",
      "tile": "9,4"
    }
  ],
  "companionLosses": {
    "Tomas": {
      "intro": [
        {
          "speaker": "Mira",
          "portrait": "tidekeeper",
          "text": "Tomas's companions showed us the high bank through the woods. They will lead our land fighters. We take the lower wheel through the reeds."
        },
        {
          "speaker": "Captain Vale",
          "portrait": "commander",
          "text": "Senn says the council will hang deserters first. Your testimony will not save you."
        },
        {
          "speaker": "Mira",
          "portrait": "tidekeeper",
          "text": "He forged the council's order. Hear the clerk, or answer for holding this flood above the village."
        },
        {
          "speaker": "Edda",
          "portrait": "harpooner",
          "text": "Bring me to the beacon. I will signal only when both wheels are ours."
        }
      ],
      "victory": [
        {
          "speaker": "Edda",
          "portrait": "harpooner",
          "text": "Both flags up. Open together—now."
        },
        {
          "speaker": "Mira",
          "portrait": "tidekeeper",
          "text": "The tide is home. Tomas should have seen it."
        },
        {
          "speaker": "Edda",
          "portrait": "harpooner",
          "text": "Put someone from each shore beside each wheel. Keep this from happening again."
        }
      ]
    }
  },
  "recruits": ["reefguard", "harpooner", "wavemender", "swordsman", "spearman", "adept"],
  "enemyRecruits": ["swordsman", "spearman", "archer"],
  "gold": 16,
  "enemyGold": 12,
  "intro": [
    {
      "speaker": "Tomas",
      "portrait": "spearman",
      "text": "The high gate is reached through the woods. I can take that path. Your swimmers can reach the lower wheel through the reeds."
    },
    {
      "speaker": "Captain Vale",
      "portrait": "commander",
      "text": "You have taken a company's books and attacked its guards. Senn says the council will hang deserters first."
    },
    {
      "speaker": "Mira",
      "portrait": "tidekeeper",
      "text": "He forged the council's order. The clerk will testify. Stand aside and hear her, or answer for keeping this flood above the village."
    },
    {
      "speaker": "Edda",
      "portrait": "harpooner",
      "text": "They are staying. Bring me to the beacon. I will not signal until both wheels are ours."
    }
  ],
  "victory": [
    {
      "speaker": "Edda",
      "portrait": "harpooner",
      "text": "Both flags up. Open together—now."
    },
    {
