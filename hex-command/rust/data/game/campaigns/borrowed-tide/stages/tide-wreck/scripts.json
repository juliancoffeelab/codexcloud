{
  "events": [
    {
      "id": "edda-lost",
      "when": {
        "killed": {
          "character": "edda"
        }
      },
      "actions": [
        {
          "defeat": "A protected companion fell. The company cannot continue."
        }
      ]
    },
    {
      "id": "cale-death",
      "when": {
        "killed": {
          "character": "cale"
        }
      },
      "actions": [
        {
          "setFlag": "cale-dead"
        }
      ]
    },
    {
      "id": "edda-death",
      "when": {
        "killed": {
          "character": "edda"
        }
      },
      "actions": [
        {
          "setFlag": "edda-dead"
        }
      ]
    },
    {
      "id": "mira-death",
      "when": {
        "killed": {
          "character": "mira"
        }
      },
      "actions": [
        {
          "setFlag": "mira-dead"
        }
      ]
    },
    {
      "id": "tomas-death",
      "when": {
        "killed": {
          "character": "tomas"
        }
      },
      "actions": [
        {
          "setFlag": "tomas-dead"
        }
      ]
    },
    {
      "id": "ledger",
      "when": {
        "stand": {
          "tile": {
            "location": "wreck"
          },
          "side": "player",
          "through": true
        }
      },
      "actions": [
        {
          "say": [
            {
              "speaker": "Clerk",
              "portrait": "worker",
              "text": "These are the original accounts. He rewrote the council's order, then made each village pay for the delay. Keep them dry; I still have two colleagues below."
            }
          ]
        },
        {
          "setFlag": "ledger"
        },
        {
          "log": "Recover the unaltered salvage ledger"
        }
      ],
      "objective": {
        "faction": "player",
        "label": "Recover the original ledger from the wreck",
        "intent": {
          "goTo": {
            "tile": {
              "location": "wreck"
            },
            "side": "player"
          }
        },
        "visibleWhen": {
          "always": true
        },
        "playerMarker": {
          "tiles": [
            {
              "location": "wreck"
            }
          ]
        }
      }
    },
    {
      "id": "await-tide",
      "when": {
        "all": [
          {
            "own": {
              "tile": {
                "location": "wreck"
              },
              "faction": "player"
            }
          },
          {
            "flag": "ledger"
          },
          {
            "not": {
              "turnAtLeast": 6
            }
          }
        ]
      },
      "actions": [
        {
          "say": [
            {
              "portrait": "harpooner",
              "text": "We have the wreck. Now wait for high tide on turn 6 so the rescue boat can reach us.",
              "character": "edda"
            }
          ]
        },
        {
          "setFlag": "await-tide"
        }
      ]
    },
    {
      "id": "rescue",
      "when": {
        "all": [
          {
            "own": {
              "tile": {
                "location": "wreck"
              },
              "faction": "player"
            }
          },
          {
            "turnAtLeast": 6
          },
          {
            "flag": "ledger"
          }
        ]
      },
      "actions": [
        {
          "say": [
            {
              "portrait": "harpooner",
              "text": "The boat is here. Hold the wreck for three turns while we bring the workers out.",
              "character": "edda"
            }
          ]
        },
        {
          "setFlag": "rescue"
        }
      ]
    },
    {
      "id": "tide-arrived",
      "when": {
        "all": [
          {
            "turnAtLeast": 6
          },
          {
            "turnAtLeast": 6
          },
          {
            "not": {
              "flag": "rescue"
            }
          }
        ]
      },
      "actions": [
        {
          "say": [
            {
              "portrait": "harpooner",
              "text": "High tide. The rescue boat is waiting. Get to the wreck so we can start.",
              "character": "edda"
            }
          ]
        },
        {
          "setFlag": "tide-arrived"
        }
      ]
    },
    {
      "id": "senns-guards",
      "when": {
        "turn": {
          "number": 4,
          "faction": "wreck-guards"
        }
      },
      "actions": [
        {
          "spawn": {
            "faction": "wreck-guards",
            "tile": {
              "hex": {
                "col": 10,
                "row": 1
              }
            },
            "radius": 2,
            "units": [
              {
                "type": "swordsman"
              }
            ]
          }
        },
        {
          "spawn": {
            "faction": "wreck-guards",
            "tile": {
              "hex": {
                "col": 11,
                "row": 5
              }
            },
            "radius": 2,
            "units": [
              {
                "type": "archer"
              }
            ]
          }
        },
        {
          "log": "Senn's hired guard arrives along the wooded shore"
        }
      ]
    },
    {
      "id": "goal-1",
      "when": {
        "own": {
          "tile": {
            "location": "wreck"
          },
          "faction": "player",
          "turns": 3,
          "when": {
            "flag": "rescue"
          }
        }
      },
      "actions": [
        {
          "setFlag": "tide-wreck-goal-1"
        }
      ],
      "objective": {
        "faction": "player",
        "label": "Defend the wreck through 3 enemy turns during the rescue",
        "intent": {
          "own": {
            "tile": {
              "location": "wreck"
            },
            "faction": "player",
            "turns": 3,
            "when": {
              "flag": "rescue"
            }
          }
        },
        "visibleWhen": {
          "always": true
        },
        "playerMarker": {
          "tiles": [
            {
              "location": "wreck"
            }
          ]
        }
      }
    },
    {
      "id": "chapter-victory",
      "when": {
        "all": [
          {
            "flag": "ledger"
          },
          {
            "flag": "tide-wreck-goal-1"
          },
          {
            "hasUnits": {
              "role": "leader",
              "side": "player"
            }
          }
        ]
      },
      "actions": [
        {
          "victory": "Mission complete. The company can rest and regroup."
        }
      ]
    }
  ],
  "requiredCompanions": ["edda"]
}
