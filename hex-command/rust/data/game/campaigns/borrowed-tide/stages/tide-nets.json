  "subtitle": "Someone has borrowed tomorrow's tide.",
  "briefing": "Rescue pilot Edda from the blocked estuary. Capture both sounding outworks and escort her to the fishing village, where she can show the townspeople why their boats are stranded.",
  "debrief": "The outworks held a forged sluice order. Edda's soundings show water diverted into an abandoned quarry, exposing the wreck of a debt ship. The salvage factor is making workers recover its ledgers before anyone can compare the books.",
  "hints": [
    "Merfolk can cross deep water and move normally on plains. Forests, groves and hills slow them and increase incoming damage.",
    "Shallows are neutral for merfolk; swamps protect them. Land troops are exposed in both.",
    "Keep Edda alive. Shore guards can reach Mira across the sandbars; protect the approaches while swimmers flank the outworks through deep water."
  ],
  "goals": [
    {
      "kind": "control",
      "label": "Open both sounding outworks",
      "tiles": ["6,2", "8,5"]
    },
    {
      "kind": "escort",
      "label": "Bring pilot Edda to the fishing village",
      "tile": "9,3"
    }
  ],
  "recruits": ["reefguard", "harpooner", "wavemender"],
  "enemyRecruits": ["spearman", "archer", "swordsman"],
  "gold": 18,
  "enemyGold": 8,
  "intro": [
    {
      "speaker": "Mira",
      "portrait": "tidekeeper",
      "text": "The tide should have returned by dawn. Our nets are dry; their boats are on the mud. This is no quarrel either shore can afford."
    },
    {
      "speaker": "Edda",
      "portrait": "harpooner",
      "text": "Vale's men took the sounding posts. I saw a sluice order bearing the council seal, but the date was cut from an older sheet."
    },
    {
      "speaker": "Postmaster Harl",
      "portrait": "commander",
      "text": "Captain Vale sent us to hold these posts for the factor's salvage crew. Bring your accusation to the council; you will not cross here."
    },
    {
      "speaker": "Mira",
      "portrait": "tidekeeper",
      "text": "Then we take the posts and bring the pilot. Leave the fishing houses standing."
    }
  ],
  "legacyDialogue": [
    {
      "speaker": "Captain Vale",
      "portrait": "commander",
      "text": "The factor pays us to keep this channel clear for salvage. Bring your accusation to the council; you will not cross my posts."
    }
  ],
  "victory": [
    {
      "speaker": "Edda",
      "portrait": "harpooner",
      "text": "Here are my soundings, and his order. The quarry gate is open. The water did not disappear; someone moved it."
    },
    {
      "speaker": "Mira",
      "portrait": "tidekeeper",
      "text": "We cannot just close that gate. There are workers inside the wreck, below the next high tide."
    }
  ],
  "events": [
    {
      "id": "nets",
      "trigger": {
        "kind": "visit",
        "tile": "5,7"
      },
      "label": "Recover provisions from the southern fishing hamlet",
      "gold": 4,
      "dialogue": [
        {
          "speaker": "Fisher",
          "portrait": "worker",
          "text": "The factor bought our food on credit too. Take these nets and rations. Bring back the people he sent into that ship."
        }
      ]
    }
  ],
  "waves": []
}
