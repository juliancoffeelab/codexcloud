  "subtitle": "Carry a message, not a conquest.",
  "briefing": "The eastern villages have gone dark. Ivo carries their names and a message for the last ferryman; Nera promises to get him across the river. The Tollkeeper’s guards block the road, but this journey is about reaching the living, not conquering the valley.",
  "hints": [
    "Move Ivo's support first. Keep him outside enemy reach until the company opens a safe path; reaching the landing matters more than clearing the map.",
    "Arrows find little purchase in bare bones. A scout's stone sling provides ranged Impact without a skeleton's melee reply.",
    "The river has more than one crossing."
  ],
  "goals": [
    {
      "kind": "escort",
      "label": "Bring Ivo to the northeastern landing",
      "tile": "11,1"
    }
  ],
  "recruits": ["swordsman", "archer", "scout"],
  "enemyRecruits": ["skeleton", "bonearcher"],
  "gold": 16,
  "enemyGold": 0,
  "intro": [
    {
      "speaker": "Ivo",
      "portrait": "scout",
      "text": "The eastern villages have not seen a lantern in three nights. I have their names here. Someone has to read them."
    },
    {
      "speaker": "Nera",
      "portrait": "commander",
      "text": "Then we get you across. Stay behind the shields. We are not here to win the river; we are here to reach the other bank."
    },
    {
      "speaker": "Ivo",
      "portrait": "scout",
      "text": "The ford north of the bridge is still open. And the ferryman hid his purse in the old riverside ruin, if we need supplies."
    }
  ],
  "victory": [
    {
      "speaker": "Ivo",
      "portrait": "scout",
      "text": "The names are safe. But the ferryman says the dead have taken three settlements farther up the road."
    },
    {
      "speaker": "Nera",
      "portrait": "commander",
      "text": "We will light each one. Let the people see that the road still belongs to the living."
    }
  ],
  "events": [
    {
      "id": "ferryman",
      "trigger": {
        "kind": "visit",
        "tile": "9,1"
      },
      "label": "Find the ferryman’s purse in the riverside ruin",
      "gold": 6,
      "dialogue": [
        {
          "speaker": "Ferryman",
          "portrait": "scout",
          "text": "Take it. Six coins will not buy my ferry back, but perhaps they will buy someone else a morning."
        }
      ]
    }
  ],
  "waves": [
    {
