    {
      "id": "monastery-lead",
      "when": {
        "all": [
          {
            "hasUnits": {
              "side": "player",
              "character": "oren"
            }
          },
          {
            "not": {
              "flag": "monastery-start"
            }
          }
        ]
      },
      "actions": [
        {
          "say": [
            {
              "portrait": "adept",
              "text": "The monastery is on the hill to the north. Get me there, and I can use its wards to clear this fog.",
              "character": "oren"
            }
          ]
        },
        {
          "log": "Oren can clear the fog from the northern hill monastery."
        },
        {
          "setFlag": "monastery-lead"
        }
      ]
    },
    {
      "id": "monastery-start",
      "when": {
        "stand": {
          "tile": "hex-0892-f4d2ec09d8",
          "side": "player",
          "unitTypes": ["adept", "mage", "archmage", "healer", "high-healer"],
          "through": false
        }
      },
      "actions": [
        {
          "spawn": {
            "faction": "enemy",
            "area": [
              "hex-0956-1372406dd4",
              "hex-0925-815fb4de6a",
              "hex-0924-5cbf18fdd5",
              "hex-0893-940b4e4db1",
              "hex-0957-c94afbbfa1"
            ],
            "aiGroup": "monastery-wolves",
            "units": [
              {
                "type": "skeletal-hound"
              },
              {
                "type": "skeletal-hound"
              }
            ]
          }
        },
        {
          "say": [
            {
              "speaker": "The company",
              "portrait": "adept",
              "text": "The stones answer the mage’s touch. The mist is bound here; three uninterrupted turns in the circle can break it. Shapes stir among the trees below."
            },
            {
              "portrait": "adept",
              "text": "Keep them back. I need three turns here to break the veil.",
              "character": "oren"
            }
          ]
        },
        {
          "log": "The hill ritual begins; skeletal wolves emerge."
        },
        {
          "setFlag": "monastery-start"
        }
      ]
    },
    {
      "id": "fog-cleared",
      "when": {
        "all": [
          {
            "held": {
              "tile": "hex-0892-f4d2ec09d8",
              "turns": 3,
              "side": "player",
              "unitTypes": ["adept", "mage", "archmage", "healer", "high-healer"]
