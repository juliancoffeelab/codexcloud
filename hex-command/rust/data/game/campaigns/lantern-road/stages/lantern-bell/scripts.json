    {
      "id": "first-toll",
      "when": {
        "any": [
          {
            "turn": 6
          },
          {
            "all": [
              {
                "chapterStarted": true
              },
              {
                "flag": "bell-tolled-before-arrival"
              }
            ]
          }
        ]
      },
      "actions": [
        {
          "sound": "bell"
        },
        {
          "forEachUnit": {
            "select": {
              "role": "captive",
              "tile": {
                "location": "northern-ritual-mark"
              }
            },
            "actions": [
              {
                "failObjective": "northern-freed"
              },
              {
                "deleteUnit": "$unit"
              },
              {
                "spawn": {
                  "faction": "bell-host",
                  "aiGroup": "bell-raised",
                  "tile": {
                    "location": "northern-ritual-mark"
                  },
                  "radius": 2,
                  "units": ["skeleton", "skeleton", "bonearcher"]
                }
              }
            ]
          }
        },
        {
          "forEachMark": {
            "select": {
              "type": "captive-death"
            },
            "actions": [
              {
                "spawn": {
                  "faction": "bell-host",
                  "aiGroup": "bell-raised",
                  "tile": {
                    "binding": "mark"
