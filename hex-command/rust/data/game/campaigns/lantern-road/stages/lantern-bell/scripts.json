          "speaker": "The Bellwarden",
          "portrait": "lich",
          "text": "More names for the bell."
        },
        {
          "speaker": "Captain Nera",
          "portrait": "swordsman",
          "text": "You\u2019ll have no more of them."
        }
      ],
      "label": "A voice carries across the valley."
