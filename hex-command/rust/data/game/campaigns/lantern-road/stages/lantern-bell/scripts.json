    {
      "id": "monastery-lead",
      "when": {
        "all": [
          {
            "hasUnits": {
              "side": "player",
              "unitTypes": ["adept", "mage", "archmage", "healer", "high-healer"]
            }
          },
          {
            "not": {
              "flag": "monastery-start"
            }
          }
        ]
      },
      "actions": [
        {
          "say": [
            {
              "with": "oren",
              "dialogue": [
                {
                  "portrait": "adept",
                  "text": "The monastery is on the hill to the north. Get me there, and I can use its wards to clear this fog.",
                  "character": "oren"
                }
              ],
              "alternative": [
                {
                  "speaker": "Storm mage",
                  "portrait": "mage",
                  "text": "The monastery is on the hill to the north. Its wards can help us clear this fog. Get one of us there."
                }
              ]
            }
          ]
        },
        {
          "log": "A mage identifies the northern hill monastery as a way to clear the fog."
        },
        {
          "setFlag": "monastery-lead"
        }
      ]
    },
    {
      "id": "monastery-start",
      "when": {
        "stand": {
          "tile": {
            "location": "monastery"
          },
          "side": "player",
          "unitTypes": ["adept", "mage", "archmage", "healer", "high-healer"],
          "through": false
        }
      },
      "actions": [
        {
          "spawn": {
            "faction": "bell-host",
            "area": [
              {
                "hex": {
                  "col": 7,
                  "row": 5
                }
              },
              {
                "hex": {
                  "col": 6,
                  "row": 6
                }
              },
              {
                "hex": {
                  "col": 6,
                  "row": 5
                }
              },
              {
                "hex": {
                  "col": 5,
                  "row": 6
                }
              },
              {
                "hex": {
                  "col": 7,
                  "row": 6
                }
              }
            ],
            "aiGroup": "monastery-wolves",
            "units": [
              {
                "type": "skeletal-hound"
              },
              {
                "type": "skeletal-hound"
              }
            ]
          }
        },
        {
          "say": [
            {
              "speaker": "The company",
              "portrait": "adept",
              "text": "The stones answer the mage’s touch. The mist is bound here; three uninterrupted turns in the circle can break it. Shapes stir among the trees below."
            },
            {
              "with": "oren",
              "dialogue": [
                {
                  "portrait": "adept",
                  "text": "Keep them back. I need three turns here to break the veil.",
                  "character": "oren"
                }
              ],
              "alternative": [
                {
                  "speaker": "Storm mage",
                  "portrait": "mage",
                  "text": "Keep them back. I need three turns here to break the veil."
                }
              ]
            }
          ]
        },
        {
          "log": "The hill ritual begins; skeletal wolves emerge."
        },
        {
          "setFlag": "monastery-start"
        }
      ]
    },
    {
