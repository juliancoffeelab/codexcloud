{
  "events": [
    {
      "id": "monastery-lead",
      "trigger": {
        "kind": "condition",
        "condition": {
          "kind": "hasUnits",
          "side": "player",
          "character": "oren"
        }
      },
      "dialogue": [
        {
          "portrait": "adept",
          "text": "The monastery is on the hill to the north. Get me there, and I can use its wards to clear this fog.",
          "character": "oren"
        }
      ],
      "label": "Oren can clear the fog from the northern hill monastery.",
      "unlessEvent": "monastery-start"
    },
    {
      "id": "monastery-start",
      "trigger": {
        "kind": "condition",
        "condition": {
          "kind": "proximity",
          "tile": "hex-0892-f4d2ec09d8",
          "side": "player",
          "radius": 0,
          "unitTypes": ["adept", "mage", "archmage", "healer", "high-healer"]
        }
      },
      "dialogue": [
        {
          "speaker": "The company",
          "portrait": "adept",
          "text": "The stones answer the mage’s touch. The mist is bound here; three uninterrupted turns in the circle can break it. Shapes stir among the trees below."
        },
        {
          "portrait": "adept",
          "text": "Keep them back. I need three turns here to break the veil.",
          "character": "oren"
        }
      ],
      "label": "The hill ritual begins; skeletal wolves emerge.",
      "spawn": {
        "aiGroup": "monastery-wolves",
        "area": [
          "hex-0956-1372406dd4",
          "hex-0925-815fb4de6a",
          "hex-0924-5cbf18fdd5",
          "hex-0893-940b4e4db1",
          "hex-0957-c94afbbfa1"
        ],
        "units": [
          {
            "id": "wolf-1",
            "type": "skeletal-hound",
            "side": "enemy"
          },
          {
            "id": "wolf-2",
            "type": "skeletal-hound",
            "side": "enemy"
          }
        ]
      }
    },
    {
      "id": "fog-cleared",
      "trigger": {
        "kind": "held",
        "tile": "hex-0892-f4d2ec09d8",
        "turns": 3
      },
      "requiresEvent": "monastery-start",
      "dialogue": [
        {
          "speaker": "The company",
          "portrait": "adept",
          "text": "The fog thins and lifts. The keep and the burial grounds lie exposed below."
        }
      ],
      "label": "The hill ritual clears the valley’s fog."
    },
    {
