{
  "events": [
    {
      "id": "monastery-lead",
      "trigger": {
        "kind": "condition",
        "condition": {
          "kind": "hasUnits",
          "side": "player",
          "name": "Oren"
        }
      },
      "dialogue": [
        {
          "speaker": "Oren",
          "portrait": "adept",
          "text": "The monastery is on the hill to the north. Get me there, and I can use its wards to clear this fog."
        }
      ],
      "label": "Oren can clear the fog from the northern hill monastery.",
      "unlessEvent": "monastery-start"
    },
    {
      "id": "monastery-start",
      "trigger": {
        "kind": "condition",
        "condition": {
          "kind": "proximity",
          "tile": "5,5",
          "side": "player",
          "radius": 0,
          "unitTypes": ["adept", "mage", "archmage", "healer", "high-healer"]
        }
      },
      "dialogue": [
        {
          "speaker": "The company",
          "portrait": "adept",
          "text": "The stones answer the mage\u2019s touch. The mist is bound here; three uninterrupted turns in the circle can break it. Shapes stir among the trees below."
        },
        {
          "speaker": "Oren",
          "portrait": "adept",
          "text": "Keep them back. I need three turns here to break the veil."
        }
      ],
      "label": "The hill ritual begins; skeletal wolves emerge.",
      "spawn": {
        "aiGroup": "monastery-wolves",
        "area": ["7,5", "6,6", "6,5", "5,6", "7,6"],
        "units": [
          {
            "id": "wolf-1",
            "type": "skeletal-hound",
            "side": "enemy"
          },
          {
            "id": "wolf-2",
            "type": "skeletal-hound",
            "side": "enemy"
          }
        ]
      }
    },
    {
      "id": "fog-cleared",
      "trigger": {
        "kind": "held",
        "tile": "5,5",
        "turns": 3
      },
      "requiresEvent": "monastery-start",
      "dialogue": [
        {
          "speaker": "The company",
          "portrait": "adept",
          "text": "The fog thins and lifts. The keep and the burial grounds lie exposed below."
        }
      ],
      "label": "The hill ritual clears the valley\u2019s fog."
    },
    {
      "id": "bell-sighted",
