      "actions": [
        {
          "say": [
            {
              "speaker": "The company",
              "portrait": "adept",
              "text": "The fog thins and lifts. The keep and the burial grounds lie exposed below."
            }
          ]
        },
        {
          "log": "The hill ritual clears the valley’s fog."
        },
        {
          "setFlag": "fog-cleared"
        }
      ],
      "objective": {
        "label": "Hold the monastery with a mage for three turns",
        "optional": true,
        "intent": {
          "hold": {
            "tile": "hex-0892-f4d2ec09d8",
            "side": "player",
            "turns": 3,
            "unitTypes": ["adept", "mage", "archmage", "healer", "high-healer"]
          }
        },
        "visibleWhen": {
          "any": [
            {
              "flag": "monastery-lead"
            },
            {
              "flag": "monastery-start"
            }
          ]
        }
      }
