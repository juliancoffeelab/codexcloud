      "dialogue": [
        {
          "speaker": "The company",
          "portrait": "captives",
          "text": "A low note builds beneath the mist. The marked stones begin to glow."
        },
        {
          "portrait": "adept",
          "text": "The bell is gathering strength. Get the prisoners off those marks—cutting their bonds won’t be enough.",
          "character": "oren"
        }
      ],
      "label": "The next toll is close."
    },
