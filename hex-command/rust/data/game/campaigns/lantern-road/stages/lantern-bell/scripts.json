        "kind": "round",
        "round": 4
      },
      "dialogue": [
        {
          "speaker": "The company",
          "portrait": "captives",
          "text": "A low note builds beneath the mist. The marked stones begin to glow."
        },
        {
          "speaker": "Oren",
          "portrait": "adept",
          "text": "The bell is gathering strength. Get the prisoners off those marks\u2014cutting their bonds won\u2019t be enough."
        }
      ],
      "label": "The next toll is close."
    },
