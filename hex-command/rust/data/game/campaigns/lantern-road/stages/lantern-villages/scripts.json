{
  "events": [
    {
      "id": "village-contact",
      "trigger": {
        "kind": "condition",
        "condition": {
          "kind": "proximity",
          "tile": "2,1",
          "radius": 0,
          "side": "player"
        }
      },
      "dialogue": [
        {
          "speaker": "Warden Sella",
          "portrait": "warden",
          "text": "Easy. Living faces—I’d almost forgotten the sight. We kept the lamps dark so the dead on the road would pass us by."
        },
        {
          "speaker": "Nera",
          "portrait": "swordsman",
          "text": "We came from the crossing. What happened here?"
        },
        {
          "speaker": "Warden Sella",
          "portrait": "warden",
          "text": "They emptied the roadside villages. There are prisoners at the old pass fort, waiting to be marched east. We haven’t the strength to fetch them."
        },
        {
          "speaker": "Nera",
          "portrait": "swordsman",
          "text": "Then we’ll bring them here. Can you keep them safe?"
        },
        {
          "speaker": "Warden Sella",
          "portrait": "warden",
          "text": "We can. I’ll go with you. There are a few here who can take up arms; give us somewhere to muster."
        }
      ],
      "recruits": ["swordsman", "spearman", "archer", "scout"],
      "choice": "hidden-village-found",
      "spawn": {
        "area": ["2,1", "2,0", "1,1", "2,2", "3,1", "1,0", "3,2"],
        "units": [
          {
            "id": "sella",
            "type": "warden",
            "side": "player",
            "name": "Warden Sella"
          }
        ]
      }
    },
    {
      "id": "foothold-established",
      "trigger": {
