      },
      "actions": [
        {
          "say": [
            {
              "portrait": "swordsman",
              "text": "He asked us to follow the people taken from the bank. This is their road.",
              "character": "nera"
            }
          ]
        },
        {
          "setFlag": "ferry-letter"
        }
      ]
    },
    {
