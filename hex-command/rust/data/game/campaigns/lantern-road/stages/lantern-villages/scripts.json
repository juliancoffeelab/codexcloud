    {
      "id": "oren-lessons",
      "trigger": {
        "kind": "condition",
        "condition": {
          "kind": "all",
          "conditions": [
            {
              "kind": "event",
              "event": "village-contact"
            },
            {
              "kind": "hasUnits",
              "side": "player",
              "character": "oren"
            }
          ]
        }
      },
      "dialogue": [
        {
          "portrait": "adept",
          "text": "That child by the hearth—those marks on the slate aren’t letters. Who taught you to draw them?",
          "character": "oren"
        },
        {
          "speaker": "Villager",
          "portrait": "captives",
          "text": "Nobody. They appear when I’m trying to remember things."
        },
        {
          "portrait": "adept",
          "text": "A little training, then. We haven’t an academy to hand, but this is better than leaving a gift untended. Stay with me; I’ll show you how to keep it from burning your fingers.",
          "character": "oren"
        }
      ],
      "recruitment": {
        "player": [
          {
            "unit": "adept"
          }
        ]
      }
    },
    {
      "id": "ferry-supplies",
      "trigger": {
        "kind": "condition",
        "condition": {
          "kind": "choice",
          "choice": "ferryman-alive"
        }
      },
      "dialogue": [
        {
          "portrait": "swordsman",
          "text": "The ferryman’s purse will buy a few more hands. Let’s make his coins count.",
          "character": "nera"
        }
      ],
      "gold": 6
    },
    {
      "id": "ferry-letter",
      "trigger": {
        "kind": "condition",
        "condition": {
          "kind": "choice",
          "choice": "ferryman-dead"
        }
      },
      "dialogue": [
        {
          "portrait": "swordsman",
          "text": "He asked us to follow the people taken from the bank. This is their road.",
          "character": "nera"
        }
      ]
    },
    {
      "id": "prisoners-found",
      "trigger": {
        "kind": "condition",
        "condition": {
          "kind": "all",
          "conditions": [
            {
              "kind": "proximity",
              "tile": "hex-0989-f27f4a3764",
              "radius": 2,
              "side": "player"
            },
            {
              "kind": "hasUnits",
              "side": "any",
