    {
      "id": "oren-lessons",
      "when": {
        "all": [
          {
            "flag": "village-contact"
          },
          {
            "proximity": {
              "target": {
                "character": "oren"
              },
              "side": "player",
              "role": "leader",
              "radius": 1
            }
          }
        ]
      },
      "actions": [
        {
          "unlockRecruits": {
            "faction": "player",
            "units": [
              {
                "unit": "adept"
              }
            ]
          }
        },
        {
          "say": [
            {
              "portrait": "adept",
              "text": "That child by the hearth\u2014those marks on the slate aren\u2019t letters. Who taught you to draw them?",
              "character": "oren"
            },
            {
              "speaker": "Villager",
              "portrait": "captives",
              "text": "Nobody. They appear when I\u2019m trying to remember things."
            },
            {
              "portrait": "adept",
              "text": "A little training, then. We haven\u2019t an academy to hand, but this is better than leaving a gift untended. Stay with me; I\u2019ll show you how to keep it from burning your fingers.",
              "character": "oren"
            }
          ]
        },
        {
          "setFlag": "oren-lessons"
        }
      ]
    },
