    {
      "id": "oren-healer-fallen",
      "trigger": {
        "kind": "condition",
        "condition": {
          "kind": "all",
          "conditions": [
            {
              "kind": "noUnits",
              "side": "enemy",
              "name": "Edrin"
            },
            {
              "kind": "hasUnits",
              "side": "player",
              "name": "Oren"
            }
          ]
        }
      },
      "requiresEvent": "oren-swamp",
      "dialogue": [
        {
          "speaker": "Oren",
          "portrait": "adept",
          "text": "Edrin. Oh, my friend. So this is what they made of you."
        },
        {
          "speaker": "Nera",
          "portrait": "swordsman",
          "text": "Oren\u2026"
        },
        {
          "speaker": "Oren",
          "portrait": "adept",
          "text": "He spent his life keeping people out of graves. Let\u2019s leave him in peace, and see that those villagers get home."
        }
      ]
    },
    {
      "id": "mire-balm-found",
      "trigger": {
        "kind": "condition",
        "condition": {
          "kind": "noUnits",
          "side": "enemy",
          "name": "Edrin"
        }
      },
      "dialogue": [
        {
          "speaker": "Nera",
          "portrait": "swordsman",
          "text": "There\u2019s a stoppered bottle in that bag. Balm, by the smell. Keep it close; we may need it before this road is done."
        }
      ],
      "requiresEvent": "swamp-sighting"
    },
