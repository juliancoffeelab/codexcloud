      "dialogue": [
        {
          "speaker": "Ivo",
          "portrait": "scout",
          "text": "Something in the reeds. It heard us."
        },
        {
          "speaker": "Nera",
          "portrait": "swordsman",
          "text": "Back onto firm ground. Let it come out where we can see it."
        }
      ]
    },
    {
      "id": "oren-swamp",
      "trigger": {
        "kind": "condition",
        "condition": {
          "kind": "all",
          "conditions": [
            {
              "kind": "event",
              "event": "swamp-sighting"
            },
            {
              "kind": "hasUnits",
              "side": "player",
              "name": "Oren"
            }
          ]
        }
      },
      "dialogue": [
        {
          "speaker": "Oren",
          "portrait": "adept",
          "text": "That smell. Something’s wrong here, beyond the bodies. Edrin used to gather his medicines in this mire."
        },
        {
          "speaker": "Nera",
          "portrait": "swordsman",
          "text": "A friend of yours?"
        },
        {
          "speaker": "Oren",
          "portrait": "adept",
          "text": "An old healer. A better one than most of my tutors. He had a house along this bank. I hope he had the sense to leave."
        }
      ]
    },
    {
      "id": "village-safe",
      "trigger": {
        "kind": "condition",
        "condition": {
          "kind": "proximity",
          "tile": "2,1",
          "radius": 0,
          "side": "player"
        }
      },
      "dialogue": [
        {
          "speaker": "Villager",
          "portrait": "captives",
          "text": "Inside. There’s broth, and room enough if we move the tables."
        },
        {
          "speaker": "Villager",
          "portrait": "captives",
          "text": "Thank you. The others are still out there. We heard a bell somewhere ahead of the column. It kept ringing long after midnight."
        },
        {
          "speaker": "Nera",
          "portrait": "swordsman",
          "text": "Send a runner back to the ferry. Tell them the dead are taking people east. We need reinforcements, and a watch along this road."
        },
        {
          "speaker": "Villager",
          "portrait": "captives",
          "text": "They’ll have your message. I’ll keep these people safe."
        },
        {
          "speaker": "Nera",
          "portrait": "swordsman",
          "text": "We can follow the column now, or clear the rest of the dead from this stretch of road first. Either way, the people here are safe."
        }
      ],
      "requiresEvent": "prisoners-freed",
      "evacuate": {
        "tile": "2,1",
        "units": {
          "side": "player",
          "role": "courier"
        }
      },
      "choice": "road-villagers-safe"
    },
    {
      "id": "tollkeeper-fallen",
      "trigger": {
        "kind": "condition",
        "condition": {
          "kind": "noUnits",
          "side": "enemy",
          "name": "The Tollkeeper"
        }
      },
      "dialogue": [
        {
          "speaker": "Nera",
          "portrait": "swordsman",
          "text": "No more soldiers from this keep. Gather what we can carry; the prisoners ahead still need us."
        }
      ],
      "choice": "tollkeeper-defeated",
      "gold": 8,
      "requiresEvent": "village-contact"
    },
    {
      "id": "eastern-departure",
      "trigger": {
        "kind": "condition",
        "condition": {
