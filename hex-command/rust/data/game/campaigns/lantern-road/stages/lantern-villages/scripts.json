      "id": "first-bell-toll",
      "trigger": {
        "kind": "round",
        "round": 26
      },
      "choice": "bell-tolled-before-arrival",
      "label": "The bell sounds in the valley. Leave the toll road by the end of turn 30.",
      "dialogue": [
        {
          "speaker": "The company",
          "portrait": "captives",
          "text": "A deep bell rolls out of the valley. For a moment, the sound seems to come from beneath the ground.",
          "sound": "bell"
        }
      ]
    },
