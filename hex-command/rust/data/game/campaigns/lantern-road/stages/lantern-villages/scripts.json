    {
      "id": "oren-swamp",
      "trigger": {
        "kind": "condition",
        "condition": {
          "kind": "all",
          "conditions": [
            {
              "kind": "event",
              "event": "swamp-sighting"
            },
            {
              "kind": "hasUnits",
              "side": "player",
              "name": "Oren"
            }
          ]
        }
      },
      "dialogue": [
        {
          "speaker": "Oren",
          "portrait": "adept",
          "text": "That smell. Something\u2019s wrong here, beyond the bodies. Edrin used to gather his medicines in this mire."
        },
        {
          "speaker": "Nera",
          "portrait": "swordsman",
          "text": "A friend of yours?"
        },
        {
          "speaker": "Oren",
          "portrait": "adept",
          "text": "An old healer. A better one than most of my tutors. He had a house along this bank. I hope he had the sense to leave."
        }
      ]
    },
    {
      "id": "village-safe",
      "trigger": {
        "kind": "condition",
        "condition": {
          "kind": "proximity",
          "tile": "2,1",
          "radius": 0,
          "side": "player"
        }
      },
      "dialogue": [
        {
          "speaker": "Villager",
          "portrait": "captives",
          "text": "Inside. There\u2019s broth, and room enough if we move the tables."
        },
        {
          "speaker": "Villager",
          "portrait": "captives",
          "text": "Thank you. The others are still out there. Please don\u2019t leave them to the dead."
        },
        {
          "speaker": "Nera",
          "portrait": "swordsman",
          "text": "Send a runner back to the ferry. Tell them the dead are taking people east. We need reinforcements, and a watch along this road."
        },
        {
          "speaker": "Villager",
          "portrait": "captives",
          "text": "They\u2019ll have your message. I\u2019ll keep these people safe."
        },
        {
          "speaker": "Nera",
          "portrait": "swordsman",
          "text": "We can move on now, or finish the dead here so they can\u2019t follow us. But every fight costs us time."
        }
      ],
      "requiresEvent": "prisoners-freed",
      "evacuate": {
        "tile": "2,1",
        "units": {
          "side": "player",
          "role": "courier"
        }
      },
      "choice": "road-villagers-safe"
    },
    {
      "id": "tollkeeper-fallen",
      "trigger": {
