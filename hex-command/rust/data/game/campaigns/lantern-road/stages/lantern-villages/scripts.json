    {
      "id": "village-safe",
      "when": {
        "all": [
          {
            "stand": {
              "tile": "hex-0386-9dcf2ec127",
              "side": "player",
              "through": false,
              "character": "villagers"
            }
          },
          {
            "flag": "prisoners-freed"
          }
        ]
      },
      "actions": [
        {
          "deleteUnit": {
            "side": "player",
            "role": "captive"
          }
        },
        {
          "say": [
            {
              "speaker": "Villager",
              "portrait": "captives",
              "text": "Inside. There’s broth, and room enough if we move the tables."
            },
            {
              "speaker": "Villager",
              "portrait": "captives",
              "text": "Thank you. The others are still out there. Please don’t leave them to the dead."
            },
            {
              "portrait": "swordsman",
              "text": "Send a runner back to the ferry. Tell them the dead are taking people east. We need reinforcements, and a watch along this road.",
              "character": "nera"
            },
            {
              "speaker": "Villager",
              "portrait": "captives",
              "text": "They’ll have your message. I’ll keep these people safe."
            },
            {
              "portrait": "swordsman",
              "text": "We can move on now, or finish the dead here so they can’t follow us. But every fight costs us time.",
              "character": "nera"
            }
          ]
        },
        {
          "setFlag": "village-safe"
        },
        {
          "setFlag": "road-villagers-safe"
        }
      ],
      "objective": {
        "label": "Bring the captives safely to the hidden village",
        "optional": false,
        "intent": {
          "escort": {
            "tile": "hex-0386-9dcf2ec127",
            "character": "villagers",
            "side": "player"
          }
        },
        "visibleWhen": {
          "flag": "prisoners-freed"
        }
      }
    },
