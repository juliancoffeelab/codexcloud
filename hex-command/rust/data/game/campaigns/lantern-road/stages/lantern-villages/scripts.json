    {
      "id": "oren-lessons",
      "trigger": {
        "kind": "condition",
        "condition": {
          "kind": "all",
          "conditions": [
            {
              "kind": "event",
              "event": "village-contact"
            },
            {
              "kind": "hasUnits",
              "side": "player",
              "name": "Oren"
            }
          ]
        }
      },
      "dialogue": [
        {
          "speaker": "Oren",
          "portrait": "adept",
          "text": "That child by the hearth\u2014those marks on the slate aren\u2019t letters. Who taught you to draw them?"
        },
        {
          "speaker": "Villager",
          "portrait": "captives",
          "text": "Nobody. They appear when I\u2019m trying to remember things."
        },
        {
          "speaker": "Oren",
          "portrait": "adept",
          "text": "A little training, then. We haven\u2019t an academy to hand, but this is better than leaving a gift untended. Stay with me; I\u2019ll show you how to keep it from burning your fingers."
        }
      ],
      "recruits": ["adept"]
    },
    {
      "id": "ferry-supplies",
      "trigger": {
        "kind": "condition",
        "condition": {
          "kind": "choice",
          "choice": "ferryman-alive"
        }
      },
      "dialogue": [
        {
          "speaker": "Nera",
          "portrait": "swordsman",
          "text": "The ferryman\u2019s purse will buy a few more hands. Let\u2019s make his coins count."
        }
      ],
      "gold": 6
    },
    {
      "id": "ferry-letter",
      "trigger": {
        "kind": "condition",
        "condition": {
          "kind": "choice",
          "choice": "ferryman-dead"
        }
      },
      "dialogue": [
        {
          "speaker": "Nera",
          "portrait": "swordsman",
          "text": "He asked us to follow the people taken from the bank. This is their road."
        }
      ]
    },
    {
      "id": "prisoners-found",
      "trigger": {
        "kind": "condition",
        "condition": {
          "kind": "proximity",
          "tile": "8,6",
          "radius": 2,
          "side": "player"
        }
      },
      "dialogue": [
        {
          "speaker": "Villager",
          "portrait": "captives",
          "text": "Over here! Don\u2019t leave us!"
        },
        {
          "speaker": "Nera",
          "portrait": "swordsman",
          "text": "Stay down. How many guards?"
        },
        {
          "speaker": "Villager",
          "portrait": "captives",
          "text": "One at the fort. The others went east. They said another column would collect us."
        },
        {
          "speaker": "Nera",
          "portrait": "swordsman",
          "text": "We\u2019re getting you out."
        }
      ],
      "requiresEvent": "village-contact"
    },
    {
      "id": "prisoners-freed",
      "trigger": {
        "kind": "condition",
        "condition": {
          "kind": "proximity",
          "side": "player",
          "radius": 0,
          "tile": "8,6",
          "unitType": "captives"
        }
      },
      "dialogue": [
        {
          "speaker": "Nera",
          "portrait": "swordsman",
          "text": "There\u2019s a village hidden in the western woods. Stay together. We\u2019ll take you there."
        },
        {
          "speaker": "Villager",
          "portrait": "captives",
          "text": "They took the others down the road. My brother, the children\u2014everyone who could still walk."
        },
        {
          "speaker": "Villager",
          "portrait": "captives",
          "text": "We heard a bell somewhere ahead of the column. It kept ringing long after midnight."
        },
        {
          "speaker": "Nera",
          "portrait": "swordsman",
          "text": "First we get you somewhere safe."
        }
      ],
      "choice": "road-prisoners-freed",
      "requiresEvent": "village-contact"
    },
    {
      "id": "road-urgency-oren",
      "trigger": {
        "kind": "condition",
        "condition": {
          "kind": "all",
          "conditions": [
            {
              "kind": "choice",
              "choice": "road-prisoners-freed"
            },
            {
              "kind": "hasUnits",
              "side": "player",
              "name": "Oren"
            }
          ]
        }
      },
      "unlessEvent": "road-urgency-nera",
      "dialogue": [
        {
          "speaker": "Oren",
          "portrait": "adept",
          "text": "A bell, and living prisoners. That sounds like a binding ritual. We have no time to spare. Get these people to shelter, then we must reach that bell before it\u2019s too late."
        }
      ]
    },
    {
      "id": "road-urgency-nera",
      "trigger": {
        "kind": "condition",
        "condition": {
          "kind": "all",
          "conditions": [
            {
              "kind": "choice",
              "choice": "road-prisoners-freed"
            },
            {
              "kind": "noUnits",
              "side": "player",
              "name": "Oren"
            }
          ]
        }
      },
      "unlessEvent": "road-urgency-oren",
      "dialogue": [
        {
          "speaker": "Captain Nera",
          "portrait": "swordsman",
          "text": "They\u2019re taking the others somewhere for a reason. We get you to shelter, then follow that column. No delays\u2014we have to reach them while they\u2019re still alive."
        }
      ]
    },
    {
      "id": "tollkeeper-provoked",
