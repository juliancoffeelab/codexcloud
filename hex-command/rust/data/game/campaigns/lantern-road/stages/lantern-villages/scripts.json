          ]
        }
      },
      "requiresEvent": "oren-swamp",
      "dialogue": [
        {
          "portrait": "adept",
          "text": "Edrin. Oh, my friend. So this is what they made of you.",
          "character": "oren"
        },
        {
          "portrait": "swordsman",
          "text": "Oren…",
          "character": "nera"
        },
        {
          "portrait": "adept",
          "text": "He spent his life keeping people out of graves. Let’s leave him in peace, and see that those villagers get home.",
          "character": "oren"
        }
      ]
    },
    {
      "id": "mire-balm-found",
      "trigger": {
        "kind": "condition",
        "condition": {
          "kind": "noUnits",
          "side": "enemy",
          "character": "edrin"
        }
      },
      "dialogue": [
        {
          "portrait": "swordsman",
          "text": "There’s a stoppered bottle in that bag. Balm, by the smell. Keep it close; we may need it before this road is done.",
          "character": "nera"
        }
      ],
      "requiresEvent": "swamp-sighting"
    },
