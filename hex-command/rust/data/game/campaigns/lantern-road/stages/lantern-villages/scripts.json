            }
          ]
        }
      },
      "dialogue": [
        {
          "speaker": "Villager",
          "portrait": "captives",
          "text": "Help! Help us!"
        }
      ],
      "requiresEvent": "village-contact"
    },
    {
      "id": "prisoners-found-guarded",
      "requiresEvent": "prisoners-found",
      "unlessEvent": "prisoners-found-unguarded",
      "trigger": {
        "kind": "condition",
        "condition": {
          "kind": "all",
          "conditions": [
            {
              "kind": "hasUnits",
              "side": "any",
              "character": "villagers"
            },
            {
              "kind": "hasUnits",
              "side": "enemy",
              "aiGroup": "captive-guard"
            }
          ]
        }
      },
      "dialogue": [
        {
          "speaker": "Skeleton guard",
          "portrait": "skeleton",
          "text": "Quiet."
        },
        {
          "speaker": "Villager",
          "portrait": "captives",
          "text": "Please—before it’s too late!"
        },
        {
          "speaker": "Skeleton guard",
          "portrait": "skeleton",
          "text": "Silence. The Bell has no use for your tongue."
        }
      ]
    },
    {
      "id": "prisoners-found-unguarded",
      "requiresEvent": "prisoners-found",
      "unlessEvent": "prisoners-found-guarded",
      "trigger": {
        "kind": "condition",
        "condition": {
          "kind": "hasUnits",
          "side": "any",
          "character": "villagers"
        }
      },
      "dialogue": [
        {
          "portrait": "swordsman",
          "text": "Keep your heads down. We’re getting you out.",
          "character": "nera"
        },
        {
          "speaker": "Villager",
          "portrait": "captives",
          "text": "They said another column was coming for us. Please—don’t let them take us."
        },
        {
          "portrait": "swordsman",
          "text": "Stay together. We’ll get you somewhere safe.",
          "character": "nera"
        }
      ]
    },
    {
      "id": "prisoners-freed",
      "trigger": {
        "kind": "condition",
        "condition": {
          "kind": "proximity",
          "side": "player",
          "radius": 0,
          "tile": "hex-0989-f27f4a3764",
          "unitType": "captives"
        }
      },
      "dialogue": [
        {
          "portrait": "swordsman",
          "text": "There’s a village hidden in the western woods. Stay together. We’ll take you there.",
          "character": "nera"
        },
        {
          "speaker": "Villager",
          "portrait": "captives",
          "text": "They took the others down the road. My brother, the children—everyone who could still walk."
        },
        {
          "speaker": "Villager",
          "portrait": "captives",
          "text": "We heard a bell somewhere ahead of the column. It kept ringing long after midnight."
        },
        {
          "portrait": "swordsman",
          "text": "First we get you somewhere safe.",
          "character": "nera"
        }
      ],
      "choice": "road-prisoners-freed",
      "requiresEvent": "village-contact"
    },
    {
      "id": "road-urgency-oren",
      "trigger": {
        "kind": "condition",
        "condition": {
          "kind": "all",
          "conditions": [
            {
              "kind": "choice",
              "choice": "road-prisoners-freed"
            },
            {
              "kind": "hasUnits",
              "side": "player",
              "character": "oren"
            }
          ]
        }
      },
      "unlessEvent": "road-urgency-nera",
      "dialogue": [
        {
          "portrait": "adept",
          "text": "A bell, and living prisoners. That sounds like a binding ritual. We have no time to spare. Get these people to shelter, then we must reach that bell before it’s too late.",
          "character": "oren"
        }
      ]
    },
    {
      "id": "road-urgency-nera",
      "trigger": {
        "kind": "condition",
        "condition": {
          "kind": "all",
          "conditions": [
            {
              "kind": "choice",
              "choice": "road-prisoners-freed"
            },
            {
              "kind": "noUnits",
              "side": "player",
              "character": "oren"
            }
          ]
        }
      },
      "unlessEvent": "road-urgency-oren",
      "dialogue": [
        {
          "portrait": "swordsman",
          "text": "They’re taking the others somewhere for a reason. We get you to shelter, then follow that column. No delays—we have to reach them while they’re still alive.",
          "character": "nera"
        }
      ]
    },
    {
