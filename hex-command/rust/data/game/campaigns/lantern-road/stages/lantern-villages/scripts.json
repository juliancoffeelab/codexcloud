    {
      "id": "village-contact",
      "when": {
        "proximity": {
          "tile": {
            "location": "shelter"
          },
          "radius": 1,
          "side": "player"
        }
      },
      "actions": [
        {
          "spawn": {
            "faction": "player",
            "area": [
              {
                "location": "shelter"
              },
              {
                "hex": {
                  "col": 2,
                  "row": 0
                }
              },
              {
                "hex": {
                  "col": 1,
                  "row": 1
                }
              },
              {
                "hex": {
                  "col": 2,
                  "row": 2
                }
              },
              {
                "hex": {
                  "col": 3,
                  "row": 1
                }
              },
              {
                "hex": {
                  "col": 1,
                  "row": 0
                }
              },
              {
                "hex": {
                  "col": 3,
                  "row": 2
                }
              }
            ],
            "units": [
              {
                "type": "warden",
                "character": "sella"
              }
            ]
          }
        },
        {
          "unlockRecruits": {
            "faction": "player",
            "units": [
              {
                "unit": "swordsman"
              },
              {
                "unit": "spearman"
              },
              {
                "unit": "archer"
              },
              {
                "unit": "scout"
              }
            ]
          }
        },
        {
          "say": [
            {
              "portrait": "warden",
              "text": "Easy. Living faces\u2014I\u2019d almost forgotten the sight. We kept the lamps dark so the dead on the road would pass us by.",
              "character": "sella"
            },
            {
              "portrait": "swordsman",
              "text": "We came from the crossing. What happened here?",
              "character": "nera"
            },
            {
              "portrait": "warden",
              "text": "A hooded figure commands the dead from the old pass fort. They call him the Tollkeeper. He had the roadside villages emptied. They've already marched one column east; the prisoners still at the fort will be next. Soon. We haven't the strength to fetch them.",
              "character": "sella"
            },
            {
              "portrait": "swordsman",
              "text": "Then we\u2019ll bring them here. Can you keep them safe?",
              "character": "nera"
            },
            {
              "portrait": "warden",
              "text": "We can. I\u2019ll go with you. There are a few here who can take up arms; give us somewhere to muster.",
              "character": "sella"
            }
          ]
        },
        {
          "setFlag": "village-contact"
        },
        {
          "setFlag": "hidden-village-found"
        }
      ],
      "objective": {
        "faction": "player",
        "label": "Find a safe foothold",
        "intent": {
          "approach": {
            "tile": {
              "location": "shelter"
            },
            "radius": 1,
            "side": "player"
          }
        },
        "visibleWhen": {
          "always": true
        },
        "playerMarker": null
      }
    },
