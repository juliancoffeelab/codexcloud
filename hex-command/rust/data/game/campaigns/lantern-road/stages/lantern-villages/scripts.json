            {
              "kind": "any",
              "conditions": [
                {
                  "kind": "event",
                  "event": "prisoners-freed"
                },
                {
                  "kind": "proximity",
                  "tile": "16,4",
                  "radius": 3,
                  "side": "player"
                }
              ]
            }
          ]
        }
      },
      "dialogue": [
        {
          "speaker": "The Tollkeeper",
          "portrait": "necromancer",
          "text": "Living soldiers on my road? You’ll pay for every step. Come closer—I’ll take the toll in bones."
        }
      ]
    },
