    {
      "id": "prisoners-found-guarded",
      "when": {
        "all": [
          {
            "all": [
              {
                "hasUnits": {
                  "side": "any",
                  "character": "villagers"
                }
              },
              {
                "hasUnits": {
                  "side": "enemy",
                  "aiGroup": "captive-guard"
                }
              }
            ]
          },
          {
            "flag": "prisoners-found"
          },
          {
            "not": {
              "flag": "prisoners-found-unguarded"
            }
          }
        ]
      },
      "actions": [
        {
          "say": [
            {
              "speaker": "Skeleton guard",
              "portrait": "skeleton",
              "text": "Quiet."
            },
            {
              "speaker": "Villager",
              "portrait": "captives",
              "text": "Please—before it’s too late!"
            },
            {
              "speaker": "Skeleton guard",
              "portrait": "skeleton",
              "text": "Silence. The Bell has no use for your tongue."
            }
          ]
        },
        {
          "setFlag": "prisoners-found-guarded"
        }
      ]
    },
    {
      "id": "prisoners-found-unguarded",
      "when": {
        "all": [
          {
            "hasUnits": {
              "side": "any",
              "character": "villagers"
            }
          },
          {
            "flag": "prisoners-found"
          },
          {
            "not": {
              "flag": "prisoners-found-guarded"
            }
          }
        ]
      },
      "actions": [
        {
          "say": [
            {
              "portrait": "swordsman",
              "text": "Keep your heads down. We’re getting you out.",
              "character": "nera"
            },
            {
              "speaker": "Villager",
              "portrait": "captives",
              "text": "They said another column was coming for us. Please—don’t let them take us."
            },
            {
              "portrait": "swordsman",
              "text": "Stay together. We’ll get you somewhere safe.",
              "character": "nera"
            }
          ]
        },
        {
          "setFlag": "prisoners-found-unguarded"
        }
      ]
    },
    {
      "id": "prisoners-freed",
      "when": {
        "all": [
          {
            "flag": "village-contact"
          },
          {
            "proximity": {
              "target": {
                "character": "villagers"
              },
              "side": "player",
              "radius": 1
            }
          }
        ]
      },
      "actions": [
        {
          "changeAllegiance": {
            "units": {
              "character": "villagers"
            },
            "faction": "player"
          }
        },
        {
          "say": [
            {
              "portrait": "swordsman",
              "text": "There’s a village hidden in the western woods. Stay together. We’ll take you there.",
              "character": "nera"
            },
            {
              "speaker": "Villager",
              "portrait": "captives",
              "text": "They took the others down the road. My brother, the children—everyone who could still walk."
            },
            {
              "speaker": "Villager",
              "portrait": "captives",
              "text": "We heard a bell somewhere ahead of the column. It kept ringing long after midnight."
            },
            {
              "portrait": "swordsman",
              "text": "First we get you somewhere safe.",
              "character": "nera"
            }
          ]
        },
        {
          "setFlag": "prisoners-freed"
        },
        {
          "setFlag": "road-prisoners-freed"
        }
      ],
      "objective": {
        "label": "Reach and free the captives",
        "visibleWhen": {
          "flag": "village-contact"
        },
        "intent": {
          "approach": {
            "target": {
              "character": "villagers"
            },
            "side": "player",
            "radius": 1
          }
        }
      }
    },
    {
      "id": "road-urgency",
      "when": {
        "flag": "road-prisoners-freed"
      },
      "actions": [
        {
          "say": [
            {
              "with": "oren",
              "dialogue": [
                {
                  "portrait": "adept",
                  "text": "A bell, and living prisoners. That sounds like a binding ritual. We have no time to spare. Get these people to shelter, then we must reach that bell before it’s too late.",
                  "character": "oren"
                }
              ],
              "alternative": [
                {
                  "portrait": "swordsman",
                  "text": "They’re taking the others somewhere for a reason. We get you to shelter, then follow that column. No delays—we have to reach them while they’re still alive.",
                  "character": "nera"
                }
              ]
            }
          ]
        }
      ]
    },
    {
