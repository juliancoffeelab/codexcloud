            }
          }
        ]
      },
      "actions": [
        {
          "say": [
            {
              "speaker": "Skeleton guard",
              "portrait": "skeleton",
              "text": "Quiet."
            },
            {
              "speaker": "Villager",
              "portrait": "captives",
              "text": "Please\u2014before it\u2019s too late!"
            },
            {
              "speaker": "Skeleton guard",
              "portrait": "skeleton",
              "text": "Silence. The Bell has no use for your tongue."
            }
          ]
        },
        {
          "setFlag": "prisoners-found-guarded"
        }
      ]
    },
    {
      "id": "prisoners-found-unguarded",
      "priority": 20,
      "when": {
        "all": [
          {
            "hasUnits": {
              "side": "any",
              "character": "villagers"
            }
          },
          {
            "flag": "prisoners-found"
          },
          {
            "not": {
              "flag": "prisoners-found-guarded"
            }
          }
        ]
      },
      "actions": [
        {
          "say": [
            {
              "portrait": "swordsman",
              "text": "Keep your heads down. We\u2019re getting you out.",
              "character": "nera"
            },
            {
              "speaker": "Villager",
              "portrait": "captives",
              "text": "Please\u2014don\u2019t let them take us through the pass."
            },
            {
              "portrait": "swordsman",
              "text": "Stay together. We\u2019ll get you somewhere safe.",
              "character": "nera"
            }
          ]
        },
        {
          "setFlag": "prisoners-found-unguarded"
        }
      ]
    },
    {
      "id": "prisoners-freed",
      "priority": 10,
      "when": {
        "all": [
          {
            "flag": "village-contact"
          },
          {
            "proximity": {
              "target": {
                "character": "villagers",
                "faction": "prisoners"
              },
              "side": "player",
              "radius": 1
            }
          }
        ]
      },
      "actions": [
        {
          "changeAllegiance": {
            "units": {
              "character": "villagers",
              "faction": "prisoners"
            },
            "faction": "player"
          }
        },
        {
          "say": [
            {
              "portrait": "swordsman",
              "text": "There\u2019s a village hidden in the western woods. Stay together. We\u2019ll take you there.",
              "character": "nera"
            },
            {
              "speaker": "Villager",
              "portrait": "captives",
              "text": "They took the others down the road. My brother, the children\u2014everyone who could still walk."
            },
            {
              "speaker": "Villager",
              "portrait": "captives",
              "text": "We heard a bell somewhere ahead of the column. It kept ringing long after midnight."
            },
            {
              "portrait": "swordsman",
              "text": "First we get you somewhere safe.",
              "character": "nera"
            }
          ]
        },
        {
          "setFlag": "prisoners-freed"
        },
        {
          "setFlag": "road-prisoners-freed"
        }
      ],
      "objective": {
        "faction": "player",
        "label": "Reach and free the captives",
        "visibleWhen": {
          "flag": "village-contact"
        },
        "intent": {
          "approach": {
            "target": {
              "character": "villagers"
            },
            "side": "player",
            "radius": 1
          }
        },
        "availableWhen": {
          "flag": "village-contact"
        },
        "playerMarker": null
      }
    },
    {
      "id": "road-urgency",
      "when": {
        "flag": "road-prisoners-freed"
      },
      "actions": [
        {
          "say": [
            {
              "with": "oren",
              "dialogue": [
                {
                  "portrait": "adept",
                  "text": "A bell, and living prisoners. It sounds like a binding ritual. Get these people to shelter, then we must reach that bell before it claims the others.",
                  "character": "oren"
                }
              ],
              "alternative": [
                {
                  "portrait": "swordsman",
                  "text": "I don't like this. Taking people alive, driving them towards that bell... Get these people to shelter. Then we follow. Whatever's waiting down that road, I won't leave the others to it.",
                  "character": "nera"
                }
              ]
            }
          ]
        }
      ]
    },
    {
