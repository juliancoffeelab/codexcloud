      "id": "deadline-0",
      "when": {
        "turnAtLeast": 31
      },
      "actions": [
        {
          "defeat": "The Bellwarden's final toll seals the road. The company has run out of time."
        }
      ],
      "notice": "Leave the toll road by the end of turn 30."
