    {
      "id": "village-contact",
      "when": {
        "proximity": {
          "tile": "hex-0386-9dcf2ec127",
          "radius": 1,
          "side": "player"
        }
      },
      "actions": [
        {
          "spawn": {
            "faction": "player",
            "area": [
              "hex-0386-9dcf2ec127",
              "hex-0385-50a8d92c35",
              "hex-0034-53333de58a",
              "hex-0397-b042f4a1af",
              "hex-0738-f0cce97107",
              "hex-0033-68054f369c",
              "hex-0749-0fa856724a"
            ],
            "units": [
              {
                "type": "warden",
                "character": "sella"
              }
            ]
          }
        },
        {
          "unlockRecruits": {
            "faction": "player",
            "units": [
              {
                "unit": "swordsman"
              },
              {
                "unit": "spearman"
              },
              {
                "unit": "archer"
              },
              {
                "unit": "scout"
              }
            ]
          }
        },
        {
          "say": [
            {
              "portrait": "warden",
              "text": "Easy. Living faces—I’d almost forgotten the sight. We kept the lamps dark so the dead on the road would pass us by.",
              "character": "sella"
            },
            {
              "portrait": "swordsman",
              "text": "We came from the crossing. What happened here?",
              "character": "nera"
            },
            {
              "portrait": "warden",
              "text": "They emptied the roadside villages. There are prisoners at the old pass fort, waiting to be marched east. We haven’t the strength to fetch them.",
              "character": "sella"
            },
            {
              "portrait": "swordsman",
              "text": "Then we’ll bring them here. Can you keep them safe?",
              "character": "nera"
            },
            {
              "portrait": "warden",
              "text": "We can. I’ll go with you. There are a few here who can take up arms; give us somewhere to muster.",
              "character": "sella"
            }
          ]
        },
        {
          "setFlag": "village-contact"
        },
        {
          "setFlag": "hidden-village-found"
        }
      ],
      "objective": {
        "label": "Find shelter for the captives",
        "intent": {
          "approach": {
            "tile": "hex-0386-9dcf2ec127",
            "radius": 1,
            "side": "player"
          }
        }
      }
    },
