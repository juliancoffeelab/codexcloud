              },
              {
                "type": "giant-bat"
              },
              {
                "type": "giant-bat"
              }
            ]
          }
        },
        {
          "say": [
            {
              "portrait": "swordsman",
              "text": "Bats! Keep them off the horses!",
              "character": "nera"
            },
            {
              "portrait": "adept",
