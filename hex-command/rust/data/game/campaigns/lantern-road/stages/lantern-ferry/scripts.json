        }
      },
      "actions": [
        {
          "spawn": {
            "faction": "wildlife",
            "area": ["hex-0187-8d8ab817b0", "hex-0220-71856b5fe2", "hex-0222-38c4b50445"],
            "aiGroup": "animals",
            "units": [
              {
