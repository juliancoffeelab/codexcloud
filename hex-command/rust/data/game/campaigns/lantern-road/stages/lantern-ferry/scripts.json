    {
      "id": "ford-shout",
      "trigger": {
        "kind": "condition",
        "condition": {
          "kind": "event",
          "event": "eastern-ford"
        }
      },
      "label": "A cry from the ferryman’s house",
      "dialogue": [
        {
          "speaker": "Ferryman",
          "portrait": "worker",
          "text": "Over here! They’re at the door! For the love of anything living, get them away from the door!"
        },
        {
          "portrait": "swordsman",
          "text": "Shields up. Make them come to us.",
          "character": "nera"
        }
      ],
      "beforeRound": 16
    },
    {
      "id": "ford-silence",
      "trigger": {
        "kind": "condition",
        "condition": {
          "kind": "all",
          "conditions": [
            {
              "kind": "event",
              "event": "eastern-ford"
            },
            {
              "kind": "round",
              "round": 16
            }
          ]
        }
      },
      "label": "No voice answers from the house",
      "dialogue": [
        {
          "portrait": "swordsman",
          "text": "No lamp. No answer. Get to the house.",
          "character": "nera"
        }
      ],
      "unlessEvent": "ford-shout"
    },
    {
      "id": "ferryman-alive",
      "trigger": {
        "kind": "condition",
        "condition": {
          "kind": "proximity",
          "tile": "hex-0323-cf4945b8a9",
          "radius": 0,
          "side": "player"
        }
      },
      "label": "The ferryman is alive",
      "dialogue": [
        {
          "speaker": "Ferryman",
          "portrait": "worker",
          "text": "I thought the door would give before anyone heard me."
        },
        {
          "portrait": "swordsman",
          "text": "We saw the landing lantern go out. Where is everyone?",
          "character": "nera"
        },
        {
          "speaker": "Ferryman",
          "portrait": "worker",
          "text": "The dead took them. Went house to house, drove them out onto the eastern road. I barred this door and put the lamp out."
        },
        {
          "portrait": "swordsman",
          "text": "Stay inside. We’ll light the villages and see what’s left.",
          "character": "nera"
        }
      ],
      "requiresEvent": "ford-shout",
      "choice": "ferryman-alive"
    },
    {
      "id": "ferryman-letter",
      "trigger": {
        "kind": "condition",
        "condition": {
          "kind": "all",
          "conditions": [
            {
              "kind": "proximity",
              "tile": "hex-0323-cf4945b8a9",
              "radius": 0,
              "side": "player"
            },
            {
              "kind": "round",
              "round": 16
            }
          ]
        }
      },
      "label": "A letter lies beside the extinguished lamp",
      "dialogue": [
        {
          "portrait": "swordsman",
          "text": "The door is broken. We’re too late.",
          "character": "nera"
        },
        {
          "speaker": "The letter",
          "portrait": "worker",
          "text": "If someone finds this: skeletons took the villagers up the eastern road. I stayed to keep the ferry ready. They have come back for me. Leave the light out. Save yourselves."
        },
        {
          "portrait": "swordsman",
          "text": "We’re lighting it. Then we follow the road.",
          "character": "nera"
        }
      ],
      "requiresEvent": "house-visit",
      "unlessEvent": "ford-shout",
      "choice": "ferryman-dead"
    },
    {
      "id": "ferryman-testimony",
      "trigger": {
        "kind": "condition",
        "condition": {
          "kind": "all",
          "conditions": [
            {
              "kind": "proximity",
              "tile": "hex-0323-cf4945b8a9",
              "radius": 1,
              "side": "player"
            },
            {
              "kind": "hasUnits",
              "side": "player",
              "character": "oren"
            }
          ]
        }
      },
      "label": "The company questions the ferryman",
      "dialogue": [
        {
          "portrait": "adept",
          "text": "Who gave the skeletons their orders? Did you see him?",
          "character": "oren"
        },
        {
          "speaker": "Ferryman",
          "portrait": "worker",
          "text": "Something in a robe. Bare bone where its face should be. The other dead stood still when it spoke."
        },
        {
          "portrait": "adept",
          "text": "A lich. Those villages weren’t attacked for their coin.",
          "character": "oren"
        },
        {
          "speaker": "Ferryman",
          "portrait": "worker",
          "text": "Then bring my neighbors back. And watch the houses. I heard things moving inside after the people were gone."
        }
      ],
      "requiresEvent": "ferryman-alive"
    },
