    {
      "id": "ford-shout",
      "when": {
        "all": [
          {
            "stand": {
              "tile": {
                "location": "eastern-ford"
              },
              "side": "player",
              "through": true
            }
          },
          {
            "not": {
              "flag": "ferryman-dead"
            }
          }
        ]
      },
      "actions": [
        {
          "setFlag": "ferryman-saved"
        },
        {
          "setFlag": "ferryman-alive"
        },
        {
          "say": [
            {
              "speaker": "Ferryman",
              "portrait": "worker",
              "text": "Over here! They\u2019re at the door! For the love of anything living, get them away from the door!"
            },
            {
              "portrait": "swordsman",
              "text": "Shields up. Make them come to us.",
              "character": "nera"
            }
          ]
        },
        {
          "log": "A cry from the ferryman\u2019s house"
        },
        {
          "setFlag": "ford-shout"
        }
      ],
      "objective": {
        "faction": "player",
        "label": "Reach the ferryman by turn 15",
        "optional": true,
        "intent": {
          "goTo": {
            "tile": {
              "location": "eastern-ford"
            },
            "side": "player"
          }
        },
        "visibleWhen": {
          "flag": "ferryman-saved"
        },
        "availableWhen": {
          "not": {
            "flag": "ferryman-dead"
          }
        },
        "playerMarker": null
      }
    },
    {
      "id": "ford-silence",
      "when": {
        "all": [
          {
            "all": [
              {
                "flag": "eastern-ford"
              },
              {
                "turnAtLeast": 16
              }
            ]
          },
          {
            "not": {
              "flag": "ford-shout"
            }
          }
        ]
      },
      "actions": [
        {
          "say": [
            {
              "portrait": "swordsman",
              "text": "No lamp. No answer. Get to the house.",
              "character": "nera"
            }
          ]
        },
        {
          "log": "No voice answers from the house"
        },
        {
          "setFlag": "ford-silence"
        }
      ]
    },
    {
      "id": "ferryman-alive",
      "when": {
        "all": [
          {
            "stand": {
              "tile": {
                "location": "ferryman-house"
              },
              "side": "player"
            }
          },
          {
            "flag": "ferryman-saved"
          }
        ]
      },
      "actions": [
        {
          "say": [
            {
              "speaker": "Ferryman",
              "portrait": "worker",
              "text": "I thought the door would give before anyone heard me."
            },
            {
              "portrait": "swordsman",
              "text": "We saw the landing lantern go out. Where is everyone?",
              "character": "nera"
            },
            {
              "speaker": "Ferryman",
              "portrait": "worker",
              "text": "The dead took them. Went house to house, drove them out onto the eastern road. I barred this door and put the lamp out."
            },
            {
              "portrait": "swordsman",
              "text": "Stay inside. We\u2019ll light the villages and see what\u2019s left.",
              "character": "nera"
            },
            {
              "with": "oren",
              "dialogue": [
                {
                  "portrait": "adept",
                  "text": "Who gave the skeletons their orders? Did you see him?",
                  "character": "oren"
                },
                {
                  "speaker": "Ferryman",
                  "portrait": "worker",
                  "text": "Something in a robe. Bare bone where its face should be. The other dead stood still when it spoke."
                },
                {
                  "portrait": "adept",
                  "text": "A lich. Those villages weren\u2019t attacked for their coin.",
                  "character": "oren"
                },
                {
                  "speaker": "Ferryman",
                  "portrait": "worker",
                  "text": "Then bring my neighbors back. And watch the houses. I heard things moving inside after the people were gone."
                }
              ]
            }
          ]
        },
        {
          "log": "The ferryman is alive"
        },
        {
          "setFlag": "ferryman-alive"
        }
      ]
    },
    {
      "id": "ferryman-letter",
      "when": {
        "all": [
          {
            "stand": {
              "tile": {
                "location": "ferryman-house"
              },
              "side": "player"
            }
          },
          {
            "flag": "ferryman-dead"
          }
        ]
      },
      "actions": [
        {
          "say": [
            {
              "portrait": "swordsman",
              "text": "The door is broken. We\u2019re too late.",
              "character": "nera"
            },
            {
              "speaker": "The letter",
              "portrait": "worker",
              "text": "If someone finds this: skeletons took the villagers up the eastern road. I stayed to keep the ferry ready. They have come back for me. Leave the light out. Save yourselves."
            },
            {
              "portrait": "swordsman",
              "text": "We\u2019re lighting it. Then we follow the road.",
              "character": "nera"
            }
          ]
        },
        {
          "log": "A letter lies beside the extinguished lamp"
        },
        {
          "setFlag": "ferryman-letter"
        },
        {
          "setFlag": "ferryman-dead"
        }
      ]
    },
