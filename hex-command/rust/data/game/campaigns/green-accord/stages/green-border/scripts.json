          {
            "owner": {
              "tile": {
                "location": "northern-fort"
              },
              "faction": "enemy"
            }
          },
          {
            "owner": {
              "tile": {
                "location": "southern-fort"
              },
              "faction": "enemy"
            }
          }
        ]
      },
      "objective": {
        "faction": "enemy",
