      "actions": []
    },
    {
      "id": "lark-lost",
      "when": {
        "killed": {
          "character": "lark"
        }
      },
      "actions": [
        {
          "defeat": "A protected companion fell. The company cannot continue."
        }
      ]
    },
    {
      "id": "alder-death",
      "when": {
        "killed": {
          "character": "alder"
        }
      },
      "actions": [
        {
          "setFlag": "alder-dead"
        }
      ]
    },
    {
      "id": "dain-death",
      "when": {
        "killed": {
          "character": "dain"
        }
      },
      "actions": [
        {
          "setFlag": "dain-dead"
        }
      ]
    },
    {
      "id": "lark-death",
      "when": {
        "killed": {
          "character": "lark"
        }
      },
      "actions": [
        {
          "setFlag": "lark-dead"
        }
      ]
    },
    {
      "id": "alternate-company",
      "when": {
        "all": [
          {
            "chapterStarted": true
          },
          {
            "flag": "dain-dead"
          }
        ]
      },
      "actions": [
        {
          "deleteUnit": {
            "character": "dain"
          }
        },
        {
          "recruits": {
            "faction": "player",
            "units": [
              {
                "unit": "wolf"
              },
              {
                "unit": "boar"
              },
              {
                "unit": "thorncaller"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "lost-tools",
      "when": {
        "stand": {
          "tile": {
            "location": "tools-cache"
          },
          "side": "player",
          "through": true
        }
      },
      "actions": [
        {
          "say": [
            {
              "portrait": "thorncaller",
              "text": "The missing crew refused to cut the sacred grove until their overdue wages were paid. Then they were ordered to report to the Rootbinder at the Overseer\u2019s river works. Their pay was never collected.",
              "character": "lark"
            },
            {
              "portrait": "wildkeeper",
              "text": "Take the ledger. We can stop the cutting, but the roots must tell us what became of those workers.",
              "character": "alder"
            }
          ]
        },
        {
          "setFlag": "lost-tools"
        },
        {
          "log": "Recover the workers\u2019 pay ledger"
        }
      ],
      "objective": {
        "faction": "player",
        "label": "Recover the workers\u2019 pay ledger",
        "intent": {
          "goTo": {
            "tile": {
              "location": "tools-cache"
            },
            "side": "player"
          }
        },
        "visibleWhen": {
          "always": true
        },
        "playerMarker": {
          "tiles": [
            {
              "location": "tools-cache"
            }
          ]
        }
      }
    },
    {
      "id": "goal-0",
      "when": {
        "objectiveSatisfied": "goal-0"
      },
      "actions": [
        {
          "setFlag": "green-border-goal-0"
        }
      ],
      "objective": {
        "faction": "player",
        "label": "Capture both logging camps",
        "intent": {
          "capture": [
            {
              "location": "northern-fort"
            },
            {
              "location": "southern-fort"
            }
          ]
        },
        "visibleWhen": {
          "always": true
        },
        "playerMarker": {
          "tiles": [
            {
              "location": "northern-fort"
            },
            {
              "location": "southern-fort"
            }
          ]
        },
        "satisfiedWhen": {
          "all": [
            {
              "owner": {
                "tile": {
                  "location": "northern-fort"
                },
                "faction": "player"
              }
            },
            {
              "owner": {
                "tile": {
                  "location": "southern-fort"
                },
                "faction": "player"
              }
            }
          ]
        }
      }
    },
    {
      "id": "chapter-victory",
      "when": {
        "all": [
          {
            "all": [
              {
                "flag": "green-border-goal-0"
              },
              {
                "flag": "lost-tools"
              },
              {
                "hasUnits": {
                  "role": "leader",
                  "side": "player"
                }
              }
            ]
          },
          {
            "objectiveSatisfied": "goal-0"
          }
        ]
