{
  "name": "hex-command",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write src scripts/*.ts tests/*.ts *.config.ts *.json README.md AGENTS.md \"art/pixel/**/*.{json,md}\"",
    "format:check": "prettier --check src scripts/*.ts tests/*.ts *.config.ts *.json README.md AGENTS.md \"art/pixel/**/*.{json,md}\"",
    "art:build": "python3 scripts/render-pixel.py --atlas",
    "art:check": "python3 scripts/render-pixel.py --check --atlas",
    "dev": "vite --host 0.0.0.0",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.tests.json",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx scripts/test.ts"
  },
  "dependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte-check": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
