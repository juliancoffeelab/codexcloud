{
  "name": "hex-command",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "node --import tsx scripts/style.ts --write",
    "format:check": "npm run style",
    "style": "node --import tsx scripts/style.ts",
    "content:check": "node --import tsx scripts/content.ts --check",
    "art:build": "python3 scripts/render-pixel.py --atlas && node --import tsx scripts/pack-styled-art.ts",
    "art:check": "python3 scripts/render-pixel.py --check --atlas && node --import tsx scripts/pack-styled-art.ts --check",
    "ai:simulate": "node --import tsx scripts/simulate-ai.ts",
    "ai:full": "node --import tsx scripts/simulate-ai.ts --mode full --seeds 10",
    "ai:benchmark": "node --import tsx scripts/benchmark-rust.ts",
    "ai:analyze": "uv run scripts/analyze-simulations.py",
    "predev": "npm run wasm:build && npm run art:build",
    "dev": "vite --host 0.0.0.0",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.tests.json",
    "precheck": "npm run wasm:build",
    "check:ui": "svelte-check --tsconfig ./tsconfig.json",
    "precheck:ui": "npm run wasm:build",
    "check:types": "tsc -p tsconfig.tests.json",
    "precheck:types": "npm run wasm:build",
    "verify": "node --import tsx scripts/verify.ts",
    "prebuild": "npm run wasm:build:release && npm run art:build",
    "build": "vite build",
    "build:check": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "publish": "python3 scripts/publish-site.py",
    "test": "node --import tsx scripts/test-budget.ts",
    "test:watch": "vitest --watch",
    "ai:rust:build": "cargo build --locked --release --manifest-path rust/Cargo.toml --bin hex-command-sim",
    "ai:rust": "npm run ai:simulate --",
    "ai:rust:full": "npm run ai:full --",
    "ai:rust:benchmark": "node --import tsx scripts/benchmark-rust.ts",
    "check:rust": "cargo test --locked --manifest-path rust/Cargo.toml --features wasm",
    "preai:simulate": "npm run ai:rust:build",
    "preai:full": "npm run ai:rust:build",
    "preai:benchmark": "npm run ai:rust:build",
    "preai:rust:benchmark": "npm run ai:rust:build",
    "ai:schedule": "npm run ai:simulate -- --schedule-only",
    "wasm:build": "wasm-pack build rust --target web --dev --out-dir pkg --out-name hex_command --no-pack --no-opt --locked --features wasm",
    "prewasm:build": "npm run content:check",
    "prewasm:build:release": "npm run content:check",
    "wasm:build:release": "wasm-pack build rust --target web --release --out-dir pkg --out-name hex_command --no-pack --no-opt --locked --features wasm",
    "bindings:generate": "npm run wasm:build",
    "check:bindings": "npm run check:wasm",
    "check:wasm": "npm run wasm:build && tsc --noEmit --strict --target ES2022 --module ESNext --moduleResolution Bundler rust/pkg/hex_command.d.ts",
    "art:expansion": "node art/pixel/reference/faction-expansion/rebuild.cjs"
  },
  "dependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte-check": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.3",
    "wasm-pack": "0.15.0"
  }
}
