{
  "name": "hex-command",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "node --import tsx scripts/style.ts --write",
    "format:check": "npm run style",
    "style": "node --import tsx scripts/verify.ts style",
    "content:check": "node --import tsx scripts/verify.ts content",
    "art:build": "python3 scripts/build-pixel-art.py",
    "art:check": "node --import tsx scripts/verify.ts art python",
    "ai:simulate": "node --import tsx scripts/simulate-ai.ts",
    "ai:full": "node --import tsx scripts/simulate-ai.ts --mode full --seeds 10",
    "ai:benchmark": "node --import tsx scripts/benchmark-rust.ts",
    "ai:analyze": "uv run scripts/analyze-simulations.py",
    "dev": "node --import tsx scripts/dev.ts",
    "check": "node --import tsx scripts/verify.ts ui types wasm",
    "check:ui": "node --import tsx scripts/verify.ts ui",
    "check:types": "node --import tsx scripts/verify.ts types",
    "verify": "node --import tsx scripts/verify.ts",
    "prebuild": "npm run wasm:build:release && npm run art:build && npm run frontend:build",
    "build": "vite build",
    "build:check": "node --import tsx scripts/verify.ts build",
    "preview": "vite preview --host 0.0.0.0",
    "publish": "python3 scripts/publish-site.py",
    "test": "node --import tsx scripts/test-budget.ts",
    "test:watch": "vitest --watch",
    "ai:rust:build": "node --import tsx .agents/skills/rust-toolchain/scripts/with-toolchain.ts cargo build --locked --release --manifest-path rust/Cargo.toml --bin hex-command-sim",
    "ai:rust": "npm run ai:simulate --",
    "ai:rust:full": "npm run ai:full --",
    "ai:rust:benchmark": "node --import tsx scripts/benchmark-rust.ts",
    "check:rust": "node --import tsx scripts/test-budget.ts --rust-only",
    "preai:simulate": "npm run ai:rust:build",
    "preai:full": "npm run ai:rust:build",
    "preai:benchmark": "npm run ai:rust:build",
    "preai:rust:benchmark": "npm run ai:rust:build",
    "ai:schedule": "npm run ai:simulate -- --schedule-only",
    "wasm:build": "node --import tsx .agents/skills/rust-toolchain/scripts/with-toolchain.ts wasm-pack build rust --target web --dev --out-dir pkg --out-name hex_command --no-pack --no-opt --locked --features wasm",
    "prewasm:build": "npm run content:check",
    "prewasm:build:release": "npm run content:check",
    "wasm:build:release": "node --import tsx .agents/skills/rust-toolchain/scripts/with-toolchain.ts wasm-pack build rust --target web --release --out-dir pkg --out-name hex_command --no-pack --no-opt --locked --features wasm",
    "bindings:generate": "npm run wasm:build",
    "check:bindings": "npm run check:wasm",
    "check:wasm": "node --import tsx scripts/verify.ts wasm",
    "toolchain:setup": "node --import tsx .agents/skills/rust-toolchain/scripts/setup-toolchain-shell.ts",
    "bindings:frontend": "node --import tsx scripts/melange-bindings.ts",
    "check:frontend-bindings": "node --import tsx scripts/verify.ts ui",
    "frontend:build": "dune build @melange --display short",
    "verify:prepare": "node --import tsx scripts/test-budget.ts --prepare"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.3",
    "wasm-pack": "0.15.0",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "melange.js": "7.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "overrides": {
    "rollup": "4.63.0"
  }
}
