{
  "name": "hex-command",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "node scripts/style.mjs",
    "format:check": "node scripts/verify.mjs style",
    "style": "npm run format",
    "content:check": "node scripts/verify.mjs content",
    "art:build": "python3 scripts/build-pixel-art.py",
    "art:check": "node scripts/verify.mjs art python",
    "ai:simulate": "node scripts/toolchain/with-toolchain.mjs cargo run --locked --manifest-path rust/Cargo.toml --profile simulation --bin hex-command-sim --",
    "ai:benchmark": "node scripts/benchmark-rust.mjs",
    "benchmark:browser": "node scripts/benchmark-browser.mjs",
    "ai:analyze": "python3 .agents/skills/combat-simulation/scripts/report-combat.py",
    "dev": "node scripts/dev.mjs",
    "check": "node scripts/verify.mjs ui types wasm",
    "check:ui": "node scripts/verify.mjs ui",
    "check:types": "node scripts/verify.mjs types",
    "verify": "node scripts/verify.mjs",
    "build": "make build",
    "build:check": "node scripts/verify.mjs build",
    "preview": "vite preview --host 0.0.0.0",
    "publish": "node scripts/site-operation.mjs deploy",
    "test": "node scripts/test-budget.mjs",
    "test:watch": "vitest --watch",
    "ai:rust:build": "node scripts/build-simulation.mjs",
    "check:rust": "node scripts/test-budget.mjs --rust-only",
    "preai:benchmark": "npm run ai:rust:build",
    "wasm:build": "make wasm PROFILE=dev",
    "wasm:build:release": "make wasm",
    "bindings:generate": "npm run wasm:build",
    "check:bindings": "npm run check:wasm",
    "check:wasm": "node scripts/verify.mjs wasm",
    "toolchain:setup": "node scripts/toolchain/setup-toolchain-shell.mjs",
    "bindings:frontend": "make wasm",
    "check:frontend-bindings": "node scripts/verify.mjs ui",
    "frontend:build": "make frontend",
    "verify:prepare": "make prepare",
    "migrations:check": "node scripts/check-migrations.mjs",
    "migrations:check-isolation": "node scripts/check-migrations-isolated.mjs",
    "migrations:generate": "node scripts/toolchain/with-toolchain.mjs python3 scripts/generate-migration-ocaml.py",
    "map:render": "node scripts/render-map.mjs"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "benchmark": "2.1.4",
    "binaryen": "120.0.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^26.1.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "melange.js": "7.0.1",
    "phaser": "3.90.0",
    "preact": "11.0.1"
  },
  "overrides": {
    "rollup": "4.63.0"
  }
}
