(version 1.3.0)

(install
 (all_platforms
  (progn
   (run %{make} install LIBDIR=%{pkg-self:lib} DOCDIR=%{pkg-self:doc})
   (run %{make} install-doc LIBDIR=%{pkg-self:lib} DOCDIR=%{pkg-self:doc}))))

(build
 (all_platforms ((action (run %{make} all PREFIX=%{prefix})))))

(depends
 (all_platforms (ocaml)))

(source
 (fetch
  (url
   https://deb.debian.org/debian/pool/main/c/cmdliner/cmdliner_1.3.0.orig.tar.bz2)
  (checksum
   sha256=8e8180f573b440f6a7a8c208dab2cae4a82384fec732d22784d1bb6e64168cbb)))
