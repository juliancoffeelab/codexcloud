(version 20240715)

(build
 (all_platforms
  ((action
    (progn
     (run cp /dev/null doc/dune.manual)
     (run dune build -p %{pkg-self:name} -j %{jobs}))))))

(depends
 (all_platforms
  (ocaml dune menhirLib menhirSdk menhirCST)))

(source
 (fetch
  (url
   https://deb.debian.org/debian/pool/main/m/menhir/menhir_20240715+ds.orig.tar.xz)
  (checksum
   sha256=6adc86fdd54309e3acc309b61266d43ea1206cdb772cfabd58d73c7116ad6cf3)))
