depends: ["ocaml" {>= "4.03"} "dune" {>= "1.3"}]
build: [
 ["mv" "fix/vendored_fix.opam" "fix/fix.opam"]
 ["mv" "fix/src/Vendored_fix.ml" "fix/src/Fix.ml"]
 ["sed" "-i.bak" "s/vendored_fix/fix/g" "fix/src/dune" "fix/fix.opam"]
 ["rm" "fix/src/dune.bak" "fix/fix.opam.bak"]
 ["dune" "build" "--root" "fix" "@install" "-j" jobs]
]
install: [
 ["mkdir" "-p" "%{lib}%/fix"]
 ["cp" "-RL" "fix/_build/install/default/lib/fix/." "%{lib}%/fix"]
]
