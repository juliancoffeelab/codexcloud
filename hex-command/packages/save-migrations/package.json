{
  "name": "@hex-command/save-migrations",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./history": "./src/history/index.ts",
    "./storage": "./src/storage-v1-to-v2.ts",
    "./steps/*": "./src/*.ts",
    "./legacy/data/*.json": "./src/legacy/data/*.json",
