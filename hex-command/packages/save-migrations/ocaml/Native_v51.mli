  ability : text;
  description : text;
  id : text;
  name : text;
  hp : int32;
  move : float;
  damage : int32;
  range : int;
  cost : int32;
  attacks : weapon array;
  damage_modifiers : damage_modifiers;
  race : Race.t;
  role : Unit_role.t;
  level : float;
  family : Family.t;
  experience_needed : float option;
