  inactive : unit_id array;
      [@ocaml.doc "Actors withheld by Campaigner, independent of unit archetypes or economy."]
  promotions : (unit_id * unit_type_id) array;
      [@ocaml.doc "Promotion branches selected by Recruiter; Planner owns their timing."]
  battle : Battle_objective.t;
  constraints : Tactical_constraint.t array;
  objectives : objective_order array;
  targets : target array;
      [@ocaml.doc "General combat/resource targets used by the existing heuristic scorers."]
  restrained : bool;
  protect_withdrawal : bool;
  mediated : unit_id array;
  withdrawal_tiles : tile_id array;
  terminal_targets : unit_id array;
  terminal_arrivals : (unit_id * tile_id) array;
  defensive_tiles : tile_id array;
  movement_tiles : tile_id array;
  leader_post : tile_id option;
  campaign : bool;
  required_units : Recruit_requirement.t array;
  transition_sensitive : (unit_id * tile_id array) array;
      [@ocaml.doc "Explicit mechanical transition dependencies supplied by Campaigner."]
  pending_arrivals : bool;
  leader_intents : (unit_id * bool option) array;
}

type campaign_orders = { recruitment : recruitment_orders; tactics : tactical_orders }

type damage_mitigation_record = {
  available_hp : int32;
  effective_damage : int32 option;
      [@ocaml.doc "Summed per-strike HP damage, accounting for drain between strikes."]
  raw_damage : int32;
  after_armour_damage : int32;
  after_terrain_damage : int32;
  effective_armour_prevented : int32;
  effective_terrain_prevented : int32;
}
[@@ocaml.doc
  "Damage stages for an executed weapon, before HP caps. Armour includes racial\n\
   and unit modifiers; terrain includes the target's environmental modifiers.\n\
   Stage differences are signed: vulnerabilities produce negative prevention.\n\
   Effective prevention caps each strike at its available HP, attributing armour\n\
   first and terrain second, so overkill cannot earn avoided-HP credit."]

type combat_mitigation_record = {
  attack : damage_mitigation_record;
  retaliation : damage_mitigation_record option;
}
[@@ocaml.doc
  "Initiating weapon and actual weapon retaliation, excluding reflected thorns.\n\
   A defender killed before its first reply has no retaliation entry."]

type thorn_record = {
  damage : int32;
  aura_damage : int32;
  effective_damage : int32;
  aura_sources : text array;
}
[@@ocaml.doc
  "Reflection separated from weapon retaliation. Effective damage is the actual\n\
   HP removed by reflection as each initiating strike lands, excluding overkill.\n\
   Aura ties share attribution; intrinsic reflection belongs to the combat's target."]

type combat_record = {
  unit : text;
  target : text;
  weapon : text;
  from_ : hex;
  target_tile : hex;
  damage : int32;
  retaliation : int32;
  count : int;
  damage_per_hit : int32;
  raw_rolls : int32 array;
  rolls : int32 array;
  response_raw_rolls : int32 array;
  response_rolls : int32 array;
  retaliation_count : int;
  retaliation_per_hit : int32;
  mediation_at_risk : bool;
  thorns : thorn_record option;
  mitigation : combat_mitigation_record option;
}
[@@ocaml.doc "The positional and damage details of a resolved attack for native reports."]

type dialogue_branch = Speech.dialogue_branch = {
  with_ : text;
  dialogue : Speech.t array;
  alternative : Speech.t array;
}

type duty_report = {
  id : text;
  actor : unit_id option;
  status : Planning_status.t;
  reason : Planning_reason.t option;
  guards : unit_id array;
  incoming : int32 option;
}

type flag_history = (text, flag_change array) Hashtbl.t

type healing_effect = {
  power : int32;
  radius : int;
  include_self : bool;
  targets : Healing_targets.t;
}

type healing_record = { target : text; providers : text array; amount : int32 }
[@@ocaml.doc
  "Actual adjacent healing after terrain healing and HP caps. Equal strongest\n\
   providers share attribution; weaker overlapping healers receive no credit."]

type hold_selection = When.hold_selection = {
  predicate : float;
  tile : Tile_ref.t;
  turns : float;
  when_ : When.t option;
  units : unit_match;
}

and own_selection = When.own_selection = {
  predicate : float;
  tile : Tile_ref.t;
  faction : text;
  turns : float option;
  when_ : When.t option;
}

type mark_loop = Event_action.mark_loop = {
  select : mark_selection;
  actions : Event_action.t array;
}

and unit_loop = Event_action.unit_loop = { select : loop_selection; actions : Event_action.t array }

type objective = {
  id : text;
  tiles : hex array;
  weight : float;
  kind : Objective_kind.t;
  actor : text option;
  family : Family.t option;
  hold : bool option;
}
[@@ocaml.doc "A weighted planning target with optional actor, family and defense constraints."]

type planning_report = {
  duties : duty_report array;
  mandatory_recruits : unit_id array;
  candidates : float;
}

type presentation_input = {
  observer : text;
  factions : faction array;
  vision_groups : vision_group_state array;
  tiles : tile array;
  units : starting_unit array;
  pending : spawn_unit array;
  lighting : map_lighting;
  marks : text array;
  choices : text array;
  memory : text array;
  round : float;
}
[@@ocaml.doc "Devtool input for the same resolver used by live Rust battles."]

type records = {
  actions : Action_record.t array;
  losses : public_unit array;
  combats : combat_record array;
  healing : healing_record array;
}
[@@ocaml.doc "Exclusively owned action, casualty and combat histories for one simulation session."]

type recruitment_shortfall = {
  selector : Unit_selector.t;
  missing : float;
  reason : Planning_reason.t;
}

type recruitment_report = {
  recruited : unit_id array;
  mandatory : unit_id array;
  requirements : recruitment_shortfall array;
}

type terrain_definition = {
