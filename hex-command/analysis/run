#!/usr/bin/env bash
set -euo pipefail
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
backend=${1:-}
mode=${2:-}
if [[ -z "$backend" || -z "$mode" || "$backend" == --help ]]; then
  cat <<'HELP'
Usage: analysis/run BACKEND MODE [arguments]
  BACKEND: polars | legacy
  MODE: report | compare-report | compare-dump

Report arguments match report-combat.py, including --baseline and telemetry flags.
Comparison arguments: BASELINE CURRENT [--out RESULT.json]
Polars uses the isolated uv project in analysis/polars.
HELP
  exit 0
fi
shift 2
case "$backend:$mode" in
  polars:report) exec uv run --project "$root/analysis/polars" python "$root/analysis/polars/main.py" "$@" ;;
  polars:compare-report) exec uv run --project "$root/analysis/polars" python "$root/analysis/polars/compare.py" "$@" ;;
  polars:compare-dump|legacy:compare-dump) exec uv run --project "$root/analysis/polars" python "$root/scripts/compare-simulation-dumps.py" "$@" ;;
  legacy:report) exec python3 "$root/.agents/skills/combat-simulation/scripts/report-combat.py" "$@" ;;
  legacy:compare-report) exec python3 "$root/scripts/compare-simulation-reports.py" "$@" ;;
  *) printf 'Unknown backend/mode: %s/%s\n' "$backend" "$mode" >&2; exit 2 ;;
esac
