[
  {
    "id": "captive-death",
    "when": {
      "killed": {
        "role": "captive"
      }
    },
    "actions": [
      {
        "createMark": {
          "type": "captive-death",
          "tile": "$event.deathTile"
        }
      }
    ]
  },
  {
    "id": "first-toll",
    "when": {
      "any": [
        {
          "turn": 6
        },
        {
          "all": [
            {
              "chapterStarted": true
            },
            {
              "flag": "arrived-late"
            }
          ]
        }
      ]
    },
    "actions": [
      {
        "sound": "bell"
      },
      {
        "forEachUnit": {
          "select": {
            "role": "captive",
            "tile": "western-ritual-mark"
          },
          "actions": [
            {
              "deleteUnit": "$unit"
            },
            {
              "spawn": {
                "tile": "western-ritual-mark",
                "faction": "bellwarden",
                "units": [
                  "skeleton",
                  "bonearcher",
                  "skeleton"
                ]
              }
            }
          ]
        }
      },
      {
        "forEachMark": {
          "select": {
            "type": "captive-death"
          },
          "actions": [
            {
              "spawn": {
                "tile": "$mark.tile",
                "faction": "bellwarden",
                "units": [
                  "skeleton",
                  "bonearcher",
                  "skeleton"
                ]
              }
            },
            {
              "removeMark": "$mark"
            }
          ]
        }
      },
      {
        "setTerrain": {
          "tile": "western-ritual-mark",
          "terrain": "inactive-ritual-mark"
        }
      }
    ]
  },
  {
    "id": "second-toll",
    "when": {
      "any": [
        {
          "turn": 12
        },
        {
          "all": [
            {
              "flag": "arrived-late"
            },
            {
              "turn": 6
            }
          ]
        }
      ]
    },
    "actions": [
      {
        "sound": "bell"
      },
      {
        "forEachUnit": {
          "select": {
            "role": "captive",
            "tile": "eastern-ritual-mark"
          },
          "actions": [
            {
              "deleteUnit": "$unit"
            },
            {
              "spawn": {
                "tile": "eastern-ritual-mark",
                "faction": "bellwarden",
                "units": [
                  "skeleton",
                  "bonearcher",
                  "skeleton"
                ]
              }
            }
          ]
        }
      },
      {
        "forEachMark": {
          "select": {
            "type": "captive-death"
          },
          "actions": [
            {
              "spawn": {
                "tile": "$mark.tile",
                "faction": "bellwarden",
                "units": [
                  "skeleton",
                  "bonearcher",
                  "skeleton"
                ]
              }
            },
            {
              "removeMark": "$mark"
            }
          ]
        }
      },
      {
        "setTerrain": {
          "tile": "eastern-ritual-mark",
          "terrain": "inactive-ritual-mark"
        }
      }
    ]
  },
  {
    "id": "third-toll",
    "when": {
      "all": [
        {
          "turn": 18
        },
        {
          "not": {
            "flag": "arrived-late"
          }
        }
      ]
    },
    "actions": [
      {
        "sound": "bell"
      },
      {
        "forEachUnit": {
          "select": {
            "role": "captive",
            "tile": "southern-ritual-mark"
          },
          "actions": [
            {
              "deleteUnit": "$unit"
            },
            {
              "spawn": {
                "tile": "southern-ritual-mark",
                "faction": "bellwarden",
                "units": [
                  "skeleton",
                  "bonearcher",
                  "skeleton"
                ]
              }
            }
          ]
        }
      },
      {
        "forEachMark": {
          "select": {
            "type": "captive-death"
          },
          "actions": [
            {
              "spawn": {
                "tile": "$mark.tile",
                "faction": "bellwarden",
                "units": [
                  "skeleton",
                  "bonearcher",
                  "skeleton"
                ]
              }
            },
            {
              "removeMark": "$mark"
            }
          ]
        }
      },
      {
        "setTerrain": {
